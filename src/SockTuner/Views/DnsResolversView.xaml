<UserControl x:Class="SockTuner.Views.DnsResolversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="130"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="EXTRA RESOLVERS (OPTIONAL)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                        <TextBox x:Name="DnsExtraResolversText" Margin="0,6,0,0" Style="{StaticResource PlaceholderBox}"
                                 Tag="1.1.1.1, 9.9.9.9"
                                 ToolTip="Comma separated. Added to the well-known list and to whatever this machine is already using"
                                 AutomationProperties.Name="Extra resolvers"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="QUERIES PER NAME" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                        <TextBox x:Name="DnsRoundsText" Text="3" Margin="0,6,0,0" AutomationProperties.Name="Queries per name"/>
                    </StackPanel>
                    <Button x:Name="RunDnsBenchmarkButton" Grid.Column="2" Content="Benchmark resolvers" ContentTemplate="{StaticResource IconContent}" Tag="&#xE768;"
                            Click="RunDnsBenchmark_Click" VerticalAlignment="Bottom" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="CancelDnsBenchmarkButton" Grid.Column="3" Content="Cancel" ContentTemplate="{StaticResource IconContent}" Tag="&#xE711;" Click="CancelDnsBenchmark_Click"
                            VerticalAlignment="Bottom" IsEnabled="False"/>
                </Grid>
            </Border>

            <ContentControl Style="{StaticResource InfoBar}" Margin="0,12,0,0"
                            Content="Each resolver is queried directly over UDP port 53, so one that is not configured on this machine can still be measured. This is read-only: no resolver is changed."/>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Verdict" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DnsVerdictText" Text="No benchmark yet." Margin="0,6,0,0" TextWrapping="Wrap" FontSize="15"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Measured resolvers" FontSize="18" FontWeight="SemiBold"/>
                    <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                    ToolTip="Ranked by median lookup time. A resolver that answers fast is not automatically the right choice: filtering, privacy and who operates it matter as much as latency."/>
                    <DataGrid x:Name="DnsResolverGrid" AutoGenerateColumns="False" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Resolver" Binding="{Binding Resolver.Display}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Median ms" Binding="{Binding MedianMs, StringFormat=N1}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding MinimumMs, StringFormat=N1}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding MaximumMs, StringFormat=N1}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Answered" Binding="{Binding Answered}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Queries" Binding="{Binding Queries}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Summary}" Width="3*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Apply a resolver" FontSize="18" FontWeight="SemiBold"/>
                    <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                    ToolTip="Applied through the supported Windows API on the selected adapter, snapshotted first and reversible from the tuning plan's history. Reverting restores exactly what was there, including DHCP-assigned resolvers."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DnsAdapterComboBox" Margin="0,0,12,0" AutomationProperties.Name="Adapter to change">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="ApplyBestDnsButton" Grid.Column="1" Content="Apply fastest resolver" ContentTemplate="{StaticResource IconContent}" Tag="&#xE73E;"
                                Click="ApplyBestDns_Click" IsEnabled="False" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="RevertDnsButton" Grid.Column="2" Content="Restore DHCP resolvers" ContentTemplate="{StaticResource IconContent}" Tag="&#xE7A7;" Click="RevertDns_Click"/>
                    </Grid>
                    <CheckBox x:Name="DnsAutoApplyCheck" Margin="0,12,0,0"
                              Content="Apply the fastest resolver automatically when a benchmark finds a worthwhile one"
                              ToolTip="Only acts when the gain is above the noise floor. Still asks for elevation, and every change is snapshotted."
                              AutomationProperties.Name="Apply the fastest resolver automatically"/>
                    <TextBlock x:Name="DnsApplyStatusText" Text="No resolver change requested." Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
