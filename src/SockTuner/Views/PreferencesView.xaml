<UserControl x:Class="SockTuner.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Stretch">
        <TextBlock Text="Live network changes" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="When off, SockTuner only reads. Turning it on shows the alpha risk notice first, and you can turn it off again at any time."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>
        <CheckBox x:Name="LiveChangesSwitch" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,26"
                  Content="Allow SockTuner to change network settings" Click="LiveChangesSwitch_Click"
                  AutomationProperties.Name="Allow SockTuner to change network settings"/>

        <TextBlock Text="Language" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="Interface language. Measurements, findings and log entries stay in English."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>
        <StackPanel Orientation="Horizontal" MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,0,26">
            <TextBlock Text="Display language" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="LanguageComboBox" Width="200"
                      SelectionChanged="Language_SelectionChanged"
                      AutomationProperties.Name="Display language"/>
        </StackPanel>

        <TextBlock Text="Local retention" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="SockTuner keeps the current log plus one rotated file. Choose the maximum size of each file."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>
        <StackPanel Orientation="Horizontal" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Log file size" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="LogRetentionComboBox" Width="150" SelectionChanged="LogRetention_SelectionChanged"
                      AutomationProperties.Name="Maximum log file size"/>
            <TextBlock Text="MB per file" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <TextBlock x:Name="PreferenceStatusText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>

        <Border Style="{StaticResource Card}" Margin="0,28,0,0" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Help improve SockTuner" FontSize="22" FontWeight="SemiBold"/>
                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,6,0,14"
                                ToolTip="Create a privacy-safe hardware capability report. It includes adapter model, driver version and supported setting constraints; it excludes current values, device IDs, addresses, paths, machine name and exact timestamps."/>
                <Button Content="Create compatibility report…" ContentTemplate="{StaticResource IconContent}" Tag="&#xE9F9;" Click="CreateCompatibilityReport_Click"
                        HorizontalAlignment="Left" AutomationProperties.Name="Create compatibility report"/>
                <TextBlock x:Name="ContributionStatusText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
