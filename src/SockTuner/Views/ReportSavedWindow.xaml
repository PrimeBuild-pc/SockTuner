<Window x:Class="SockTuner.Views.ReportSavedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibility report saved" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindowStyle}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock Text="Compatibility report saved" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="The file is plain text with no addresses, names or current values. Look at it if you wish, then send it with one of the options below."
                   TextWrapping="Wrap" Margin="0,16,0,0"/>
        <TextBlock Text="GitHub: attach the file to the issue form. Discord: post it in the issues channel."
                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Close" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="Open Discord" Click="Discord_Click" Margin="0,0,8,0"/>
            <Button Content="Open GitHub issue" Style="{StaticResource PrimaryButton}" Click="GitHub_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
