<UserControl x:Class="SockTuner.Views.WifiDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
        <StackPanel>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Passive Windows WLAN data. Refresh and observation use the Windows cache and never trigger a Wi-Fi scan."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <ComboBox x:Name="InterfaceComboBox" MinWidth="240" Margin="0,0,8,8"
                              SelectionChanged="Interface_SelectionChanged"
                              AutomationProperties.Name="Wi-Fi interface">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Description}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="RefreshButton" Content="Refresh passive data" ContentTemplate="{StaticResource IconContent}" Tag="&#xE72C;" Click="Refresh_Click"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                    <Button x:Name="ObserveButton" Content="Observe for 60 seconds" ContentTemplate="{StaticResource IconContent}" Tag="&#xE768;" Click="Observe_Click"
                            Margin="0,0,8,8" IsEnabled="False"/>
                    <Button x:Name="CancelObserveButton" Content="Cancel" ContentTemplate="{StaticResource IconContent}" Tag="&#xE711;" Click="CancelObserve_Click"
                            Margin="0,0,0,8" IsEnabled="False"/>
                </WrapPanel>
            </Grid>

            <Border x:Name="PermissionCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Windows blocked Wi-Fi details" Style="{StaticResource CardTitleText}"/>
                    <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,6,0,12"
                                    ToolTip="Allow desktop apps to use Location in Windows Settings, then refresh. SockTuner does not need your physical location; Windows gates WLAN details behind this permission."/>
                    <Button Content="Open Location settings" ContentTemplate="{StaticResource IconContent}" Tag="&#xE713;" Click="OpenLocationSettings_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Text="Refresh to inspect Wi-Fi."
                       Style="{StaticResource LocalStatusText}" Margin="4,12,0,0"
                       AutomationProperties.LiveSetting="Polite"/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="260"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Current connection" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock x:Name="ConnectionText" Text="Not inspected." Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <DataGrid x:Name="EvidenceGrid" AutoGenerateColumns="False" MaxHeight="260" Margin="0,12,0,0"
                                  Style="{StaticResource ResultGrid}" AutomationProperties.Name="Current connection">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fact" Binding="{Binding Name}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gaming impact" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock x:Name="VerdictText" Text="- Not enough data" FontSize="20" FontWeight="SemiBold"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SummaryText" Text="Refresh passive data first."
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Unknowns" Style="{StaticResource CardTitleText}" Margin="0,18,0,0"/>
                        <TextBlock x:Name="UnknownsText" Text="Not inspected." Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Evidence-ranked Wi-Fi findings" Style="{StaticResource SectionTitleText}"/>
                    <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" Margin="0,12,0,0"
                              MinHeight="120" MaxHeight="280" RowHeight="NaN" MinRowHeight="40"
                              Style="{StaticResource ResultGrid}" AutomationProperties.Name="Evidence-ranked Wi-Fi findings">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="2*" MinWidth="160" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="3*" MinWidth="180" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Owner" Binding="{Binding OwnerDisplay}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="3*" MinWidth="180" ElementStyle="{StaticResource WrapCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="NoFindingsText" Text="No Wi-Fi finding from the available evidence."
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Nearby channel pressure" Style="{StaticResource SectionTitleText}"/>
                    <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                    ToolTip="Cached beacons show potential pressure, not the airtime used by every client. Utilization appears only when an access point publishes BSS Load."/>
                    <DataGrid x:Name="ChannelsGrid" AutoGenerateColumns="False" MinHeight="140" MaxHeight="260"
                              Style="{StaticResource ResultGrid}" AutomationProperties.Name="Nearby channel pressure">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Band" Binding="{Binding BandDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="BSS count" Binding="{Binding BssCount}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Strongest RSSI" Binding="{Binding StrongestRssiDbm}" Width="110" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Overlapping" Binding="{Binding OverlappingBssCount}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="AP utilization" Binding="{Binding UtilizationDisplay}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Expander Header="Technical details and passive samples">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock x:Name="TechnicalText" Text="Not inspected." TextWrapping="Wrap"/>
                        <DataGrid x:Name="SamplesGrid" AutoGenerateColumns="False" MaxHeight="240" Margin="0,12,0,0"
                                  Style="{StaticResource ResultGrid}" AutomationProperties.Name="Technical details and passive samples">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="Signal" Binding="{Binding SignalDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="Negotiated rate" Binding="{Binding RateDisplay}" Width="220" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="Detail" Binding="{Binding Error}" Width="2*" MinWidth="160" ElementStyle="{StaticResource WrapCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
