<UserControl x:Class="SockTuner.Views.HostDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
        <StackPanel>
            <ContentControl Style="{StaticResource InfoBar}"
                            Content="Analysis runs with your network check. Driver cleanup is separate from latency diagnosis; every change requires your choice and administrator approval."/>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Process connections" FontSize="18" FontWeight="SemiBold"/>
                    <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                    ToolTip="Read from the same owner-PID TCP table Resource Monitor uses (GetExtendedTcpTable). No packet is captured or inspected; only which process owns each connection and its current state."/>
                    <TextBlock x:Name="ProcessConnectionsStatusText" Text="No run yet." TextWrapping="Wrap" FontSize="15" Margin="0,0,0,8"/>
                    <DataGrid x:Name="ProcessConnectionsGrid" AutoGenerateColumns="False" MinHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="2*" MinWidth="120" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Connections" Binding="{Binding ConnectionCount}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Established" Binding="{Binding EstablishedCount}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Driver store cleanup" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DriverCleanupStatusText" Text="No run yet." TextWrapping="Wrap" Margin="0,8,0,8"/>
                    <ComboBox x:Name="DriverCleanupComboBox" DisplayMemberPath="Summary" SelectionChanged="DriverCleanupSelectionChanged" Margin="0,0,0,8"/>
                    <Button Content="Open Driver Store Explorer (RAPR)" Click="OpenRapr_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <Border x:Name="UninstallRow" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="UninstallTitleText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="UninstallDetailText" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="UninstallApplyButton" Content="Apply" Click="UninstallApply_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                <Button x:Name="UninstallDismissButton" Content="Dismiss" Click="UninstallDismiss_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="UninstallStatusText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Driver interrupt activity (DPC/ISR)" FontSize="18" FontWeight="SemiBold"/>
                    <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                    ToolTip="Measures driver activity and latency together in repeated windows after a short baseline. A single spike, missing replies or ambiguous device mapping cannot enable an action. Repeated co-occurrence is not proof of causation. Needs administrator rights."/>
                    <TextBlock x:Name="DpcIsrFindingText" Text="No run yet." TextWrapping="Wrap" FontSize="15" Margin="0,0,0,12"/>

                    <TextBlock Text="Recommended actions" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Border x:Name="AffinityRow" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="AffinityTitleText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AffinityDetailText" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AffinityApplyButton" Content="Apply" Click="AffinityApply_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                <Button x:Name="AffinityModifyButton" Content="Modify…" Click="AffinityModify_Click" Margin="0,0,8,0"/>
                                <Button x:Name="AffinityDismissButton" Content="Dismiss" Click="AffinityDismiss_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="AffinityStatusText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DisableRow" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="DisableTitleText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DisableDetailText" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="DisableApplyButton" Content="Apply" Click="DisableApply_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                <Button x:Name="DisableDismissButton" Content="Dismiss" Click="DisableDismiss_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="DisableStatusText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="NoActionsText" Text="Nothing measured here is worth acting on yet." TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="Full ranking" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,8"/>
                    <DataGrid x:Name="DpcIsrRankingGrid" AutoGenerateColumns="False" MinHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="ISR ms" Binding="{Binding ElapsedIsrMs, StringFormat=N2}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="DPC ms" Binding="{Binding ElapsedDpcMs, StringFormat=N2}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Total ms" Binding="{Binding TotalElapsedMs, StringFormat=N2}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                            <DataGridTextColumn Header="Events" Binding="{Binding EventCount}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
