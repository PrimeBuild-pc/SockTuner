<UserControl x:Class="SockTuner.Views.TuningPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Adapter tuning" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Only properties the selected driver actually advertises are listed. Every change is previewed, snapshotted, verified by read-back, and reversible from the audit history below."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border x:Name="WriteStateBadge" Grid.Column="1" Background="{StaticResource WarningMutedBrush}"
                            BorderBrush="#E6C15A" BorderThickness="1" Padding="12,6" VerticalAlignment="Top">
                        <TextBlock x:Name="WriteStateText" Text="ALPHA · LIVE CHANGES" Foreground="{StaticResource WarningBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*" MinWidth="130"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Adapter" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="AdapterComboBox" Grid.Column="1"
                              SelectionChanged="Adapter_SelectionChanged"
                              AutomationProperties.Name="Adapter to tune">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Focus" Grid.Column="2" VerticalAlignment="Center" Margin="18,0,10,0"/>
                    <ComboBox x:Name="PresetComboBox" Grid.Column="3"
                              SelectionChanged="Preset_SelectionChanged"
                              AutomationProperties.Name="Tuning focus preset">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="PresetDescriptionText" Grid.Column="4" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="18,0,12,0"/>
                    <Button Grid.Column="5" Content="Reload capabilities" Click="ReloadCapabilities_Click"/>
                </Grid>
            </Border>

            <TextBlock x:Name="CapabilitySummaryText" Text="Select an adapter to list its driver-advertised properties."
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="4,12,0,0"/>

            <DataGrid x:Name="CapabilityGrid" AutoGenerateColumns="False" Height="300" Margin="0,10,0,0"
                      IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionChanged="Capability_SelectionChanged"
                      AutomationProperties.Name="Driver-advertised adapter properties">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Property" Binding="{Binding Capability.DisplayName}" Width="190" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Keyword" Binding="{Binding Capability.Keyword}" Width="155" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Current" Binding="{Binding Capability.CurrentDisplay}" Width="115" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Default" Binding="{Binding Capability.DefaultDisplay}" Width="115" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Proposed" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True" ItemsSource="{Binding Options}"
                                          Text="{Binding ProposedValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          AutomationProperties.Name="Proposed value"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Accepted values" Binding="{Binding Capability.ConstraintDisplay}" Width="*" MinWidth="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Risk" Binding="{Binding Capability.RiskBadge}" Width="95" IsReadOnly="True"
                                        ElementStyle="{StaticResource RiskCellText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="CapabilityDetailHeadingText" Text="Select a property"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CapabilityDetailText" Foreground="{StaticResource MutedTextBrush}"
                               Text="Its keyword, what it trades against, and everything the driver will accept are shown here."
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Preview changes" Click="Preview_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click" IsEnabled="False" Margin="0,0,8,0"/>
                        <Button Content="Discard proposals" Click="Discard_Click" Margin="0,0,18,0"/>
                        <TextBlock Text="Confirm high-risk" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0"/>
                        <TextBox x:Name="ConfirmationText" Width="130" VerticalContentAlignment="Center" IsEnabled="False"
                                 ToolTip="Type APPLY to confirm high-risk or experimental changes"
                                 AutomationProperties.Name="High-risk confirmation"/>
                    </StackPanel>
                    <TextBlock x:Name="PlanStatusText" Text="No plan prepared." Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="PlanPreviewGrid" AutoGenerateColumns="False" Height="170" Margin="0,14,0,0" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Setting" Binding="{Binding Definition.Title}" Width="190"/>
                    <DataGridTextColumn Header="Current" Binding="{Binding BeforeDisplay}" Width="115"/>
                    <DataGridTextColumn Header="Proposed" Binding="{Binding AfterDisplay}" Width="115"/>
                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskBadge}" Width="95"
                                        ElementStyle="{StaticResource RiskCellText}"/>
                    <DataGridTextColumn Header="Evidence" Binding="{Binding Definition.Evidence}" Width="120"/>
                    <DataGridTextColumn Header="Restart" Binding="{Binding Definition.RestartRequirement}" Width="130"/>
                    <DataGridTextColumn Header="Extra confirm" Binding="{Binding RequiresExplicitConfirmation}" Width="100"/>
                    <DataGridTextColumn Header="Trade-off" Binding="{Binding Definition.TradeOff}" Width="*" MinWidth="160"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Transaction audit history" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Select an applied entry to restore exactly the values it captured: the Current column of the plan it applied."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Roll back selected" Click="Rollback_Click" VerticalAlignment="Bottom"/>
            </Grid>
            <DataGrid x:Name="TransactionAuditGrid" AutoGenerateColumns="False" Height="150" Margin="0,10,0,0" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding RecordedAt}" Width="170"/>
                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="150"/>
                    <DataGridTextColumn Header="Changes" Binding="{Binding Changes.Count}" Width="80"/>
                    <DataGridTextColumn Header="Snapshot" Binding="{Binding SnapshotId}" Width="200"/>
                    <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
