<UserControl x:Class="SockTuner.Views.TuningPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Adapter tuning" FontSize="22" FontWeight="SemiBold"/>
                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,8,0,0"
                                        ToolTip="Only properties the selected driver actually advertises are listed. Every change is previewed, snapshotted, verified by read-back, and reversible from the audit history below."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <CheckBox x:Name="LiveChangesSwitch" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              Content="Allow SockTuner to change network settings" Click="LiveChangesSwitch_Click"
                              AutomationProperties.Name="Allow SockTuner to change network settings"/>
                    <Border x:Name="WriteStateBadge" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock x:Name="WriteStateText" Text="ALPHA · LIVE CHANGES" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*" MinWidth="130"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Adapter" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="AdapterComboBox" Grid.Column="1"
                              SelectionChanged="Adapter_SelectionChanged"
                              AutomationProperties.Name="Adapter to tune">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Focus" Grid.Column="2" VerticalAlignment="Center" Margin="18,0,10,0"/>
                    <ComboBox x:Name="PresetComboBox" Grid.Column="3"
                              SelectionChanged="Preset_SelectionChanged"
                              AutomationProperties.Name="Tuning focus preset">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="PresetDescriptionText" Grid.Column="4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="18,0,12,0"/>
                    <Button Grid.Column="5" Content="Reload capabilities" ContentTemplate="{StaticResource IconContent}" Tag="&#xE72C;" Click="ReloadCapabilities_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Presets" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UseCaseDescriptionText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <ComboBox x:Name="UseCaseComboBox" Width="280" Margin="0,0,8,0" SelectionChanged="UseCase_SelectionChanged"
                                  DisplayMemberPath="DisplayName" AutomationProperties.Name="Preset"/>
                        <Button x:Name="LoadUseCaseButton" Content="Load preset into the plan" ContentTemplate="{StaticResource IconContent}"
                                Tag="&#xE945;" Click="LoadUseCase_Click" Style="{StaticResource PrimaryButton}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Border x:Name="VerificationBadge" CornerRadius="12" BorderThickness="1" Padding="10,3" Margin="0,0,10,4" VerticalAlignment="Center">
                            <TextBlock x:Name="VerificationBadgeText" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="ReportAdapterButton" Content="Report this adapter…" ContentTemplate="{StaticResource IconContent}"
                                Tag="&#xE9F9;" Click="ReportAdapter_Click" Margin="0,0,0,4" Visibility="Collapsed"/>
                    </WrapPanel>
                    <TextBlock x:Name="VerificationHintText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="CapabilitySummaryText" Text="Select an adapter to list its driver-advertised properties."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="4,12,0,0"/>

            <DataGrid x:Name="CapabilityGrid" AutoGenerateColumns="False" MinHeight="300" MaxHeight="720" Margin="0,10,0,0"
                      IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionChanged="Capability_SelectionChanged"
                      AutomationProperties.Name="Driver-advertised adapter properties">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Property" Binding="{Binding Capability.DisplayName}" Width="190" IsReadOnly="True" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Keyword" Binding="{Binding Capability.Keyword}" Width="155" IsReadOnly="True" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Current" Binding="{Binding Capability.CurrentDisplay}" Width="115" IsReadOnly="True" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Default" Binding="{Binding Capability.DefaultDisplay}" Width="115" IsReadOnly="True" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTemplateColumn Header="Proposed" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True" ItemsSource="{Binding Options}"
                                          Text="{Binding ProposedValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          AutomationProperties.Name="Proposed value"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Accepted values" Binding="{Binding Capability.ConstraintDisplay}" Width="*" MinWidth="150" IsReadOnly="True" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Risk" Binding="{Binding Capability.RiskBadge}" Width="95" IsReadOnly="True"
                                        ElementStyle="{StaticResource RiskCellText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="CapabilityDetailHeadingText" Text="Select a property"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CapabilityDetailText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Its keyword, what it trades against, and everything the driver will accept are shown here."
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Preview changes" ContentTemplate="{StaticResource IconContent}" Tag="&#xE890;" Click="Preview_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button x:Name="ApplyButton" Content="Apply" ContentTemplate="{StaticResource IconContent}" Tag="&#xE73E;" Click="Apply_Click" IsEnabled="False" Margin="0,0,8,0"/>
                        <Button Content="Discard proposals" ContentTemplate="{StaticResource IconContent}" Tag="&#xE711;" Click="Discard_Click" Margin="0,0,18,0"/>
                        <TextBlock Text="Confirm high-risk" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBox x:Name="ConfirmationText" Width="130" VerticalContentAlignment="Center" IsEnabled="False"
                                 ToolTip="Type APPLY to confirm high-risk or experimental changes"
                                 AutomationProperties.Name="High-risk confirmation"/>
                    </StackPanel>
                    <TextBlock x:Name="PlanStatusText" Text="No plan prepared." Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="PlanPreviewGrid" AutoGenerateColumns="False" Height="170" Margin="0,14,0,0" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Setting" Binding="{Binding Definition.Title}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Current" Binding="{Binding BeforeDisplay}" Width="115" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Proposed" Binding="{Binding AfterDisplay}" Width="115" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskBadge}" Width="95"
                                        ElementStyle="{StaticResource RiskCellText}"/>
                    <DataGridTextColumn Header="Evidence" Binding="{Binding Definition.Evidence}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Restart" Binding="{Binding Definition.RestartRequirement}" Width="130" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Extra confirm" Binding="{Binding RequiresExplicitConfirmation}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Trade-off" Binding="{Binding Definition.TradeOff}" Width="*" MinWidth="160"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Transaction audit history" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Select an applied entry to restore exactly the values it captured: the Current column of the plan it applied."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Check for drift" ContentTemplate="{StaticResource IconContent}" Tag="&#xE9D9;" Click="CheckDrift_Click" VerticalAlignment="Bottom"
                        Margin="0,0,8,0"
                        ToolTip="Reads back every setting SockTuner has written and reports the ones something else has changed since"/>
                <Button Grid.Column="2" Content="Roll back selected" ContentTemplate="{StaticResource IconContent}" Tag="&#xE7A7;" Click="Rollback_Click" VerticalAlignment="Bottom"/>
            </Grid>
            <TextBlock x:Name="DriftSummaryText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Nothing checked yet. A driver update or another tuning tool can put a setting back without telling anyone."/>
            <DataGrid x:Name="DriftGrid" AutoGenerateColumns="False" MaxHeight="180" Margin="0,10,0,0" IsReadOnly="True"
                      RowHeight="NaN" MinRowHeight="36" Style="{StaticResource ResultGrid}"
                      AutomationProperties.Name="Settings changed outside SockTuner">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="State" Binding="{Binding StateBadge}" Width="150"
                                        ElementStyle="{StaticResource VerdictCellText}"/>
                    <DataGridTextColumn Header="Setting" Binding="{Binding SettingId}" Width="*" MinWidth="150" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="SockTuner wrote" Binding="{Binding ExpectedDisplay}" Width="130" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Now holds" Binding="{Binding ActualDisplay}" Width="130" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Written" Binding="{Binding WrittenAtDisplay}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Error}" Width="*" MinWidth="130"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="TransactionAuditGrid" AutoGenerateColumns="False" Height="150" Margin="0,10,0,0" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding RecordedAt}" Width="170" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Changes" Binding="{Binding Changes.Count}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Snapshot" Binding="{Binding SnapshotId}" Width="200" ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
