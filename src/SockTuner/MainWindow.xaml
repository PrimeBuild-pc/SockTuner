<Window x:Class="SockTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SockTuner" Height="800" Width="1280" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SOCK" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="TUNER" FontSize="25" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Windows network control and gaming diagnostics" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PrimaryMutedBrush}" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="READ-ONLY PREVIEW" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE ADAPTERS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ActiveAdaptersText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="NETWORK DEVICES" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AdapterCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="LOGICAL PROCESSORS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ProcessorCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PRIVILEGE" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PrivilegeText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,12,0,0" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="System baseline" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Current read-only system facts. No setting is changed during discovery." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Operating system" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                                        <TextBlock x:Name="OsText" Grid.Column="1" Text="Loading…" Margin="0,5"/>
                                        <TextBlock Grid.Row="1" Text="Build" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                                        <TextBlock x:Name="BuildText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,5"/>
                                        <TextBlock Grid.Row="2" Text="Computer" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                                        <TextBlock x:Name="MachineText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,5"/>
                                        <TextBlock Grid.Row="3" Text="Captured" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                                        <TextBlock x:Name="CapturedText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Safe workflow" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="1  Inspect the current state" Margin="0,18,0,8"/>
                                    <TextBlock Text="2  Diagnose each network boundary" Margin="0,8"/>
                                    <TextBlock Text="3  Preview a typed change plan" Margin="0,8"/>
                                    <TextBlock Text="4  Snapshot, apply, verify, roll back" Margin="0,8"/>
                                    <TextBlock Text="Mutations remain disabled in this preview build." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Adapters">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Network adapters" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Stable identity, state, link speed, addresses, gateways, and protocol support." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh inventory" Click="RefreshInventory_Click" VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid x:Name="AdaptersGrid" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding InterfaceType}" Width="140"/>
                            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Protocols" Binding="{Binding ProtocolsDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Inventory" Binding="{Binding InventoryStatus}" Width="160"/>
                            <DataGridTextColumn Header="Addresses" Binding="{Binding AddressesDisplay}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Gaming diagnostics">
                <Border Style="{StaticResource Card}" Margin="0,20,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Layered gaming diagnosis" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="The next phase will correlate gateway, ISP boundary, neutral reference, route, DNS, and game-endpoint evidence." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="No test runs automatically, and no network setting will be changed." Foreground="{StaticResource PrimaryBrush}" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Tuning plan">
                <Border Style="{StaticResource Card}" Margin="0,20,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Evidence-gated tuning" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Driver-advertised properties and Windows settings will appear here as a dry-run diff before any elevated action." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="Live mutation backend: disabled" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBlock Grid.Column="1" Text="PRE-ALPHA 0.1" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
