<Window x:Class="SockTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SockTuner.Views"
        Title="SockTuner" Icon="Assets/SockTuner.ico" Height="820" Width="1320" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindowStyle}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- One command row, like a Windows 11 app header: identity on the left, the actions that
             apply to the whole inventory on the right. -->
        <Grid Grid.Row="0" Margin="20,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="SockTuner" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Windows network control and gaming diagnostics" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="InventoryFilterText" Width="260" Margin="0,4,8,4"
                         Style="{StaticResource PlaceholderBox}" Tag="Search all inventory  (Ctrl+F)"
                         TextChanged="InventoryFilter_TextChanged" AutomationProperties.Name="Search all inventory"/>
                <CheckBox x:Name="AdvancedModeCheck" Style="{StaticResource ToggleSwitch}" Content="Advanced mode" Margin="0,4,12,4" VerticalAlignment="Center"
                          Checked="AdvancedMode_Changed" Unchecked="AdvancedMode_Changed"
                          ToolTip="Show every section, including the technical ones. Off keeps only what a first-time user needs."/>
                <Button Content="Refresh" ContentTemplate="{StaticResource IconContent}" Tag="&#xE72C;" Click="RefreshInventory_Click" Margin="0,4,8,4"
                        Style="{StaticResource PrimaryButton}" ToolTip="Re-read the whole Windows network inventory  (F5)"
                        AutomationProperties.Name="Refresh network inventory"/>
                <Button x:Name="CopyInventoryRowButton" Content="Copy row" ContentTemplate="{StaticResource IconContent}" Tag="&#xE8C8;" Click="CopyInventorySelected_Click"
                        Margin="0,4,8,4" IsEnabled="False"
                        ToolTip="Copies the selected inventory row as JSON"/>
                <!-- Three exports that are each used once a session do not each deserve a button
                     the width of the primary action. -->
                <Button x:Name="ExportMenuButton" Content="Export  ▾" ContentTemplate="{StaticResource IconContent}" Tag="&#xEDE1;" Click="ExportMenu_Click" Margin="0,4,12,4"
                        AutomationProperties.Name="Export menu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export snapshot…" Click="ExportSnapshot_Click"/>
                            <MenuItem Header="Export support snapshot…" Click="ExportSupportSnapshot_Click"/>
                            <MenuItem Header="Create compatibility report…" Click="CreateCompatibilityReport_Click"/>
                            <MenuItem Header="Export logs…" Click="ExportLogs_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <!-- Colours and icon are set by ShowWriteState: they follow the consent, not the XAML. -->
                <Border x:Name="WriteStateBadge" BorderThickness="1" CornerRadius="13" Padding="10,4,12,4" Margin="0,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="WriteStateIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock x:Name="WriteStateText" Text="Inventory only" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   ToolTip="Writes require accepting the change consent, elevation, and an explicit confirmation in the tuning plan."/>
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                        Margin="8,4,0,4" Padding="10,6" Click="Settings_Click"
                        ToolTip="Preferences" AutomationProperties.Name="Preferences"/>
            </WrapPanel>
        </Grid>

        <!-- Shown only while something is running: a large spinner and the current step, so nobody
             mistakes a long analysis for a frozen window. -->
        <Border x:Name="BusyBanner" Grid.Row="1" Visibility="Collapsed" Margin="20,0,16,10" Padding="18,12"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2">
            <DockPanel>
                <views:BusySpinner Width="48" Height="48" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Working…" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Text, ElementName=StatusText}" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="InventoryTabs" Grid.Row="2" SelectionChanged="InventoryTabs_SelectionChanged">
            <TabItem Header="Overview" Style="{StaticResource NavGroupHeader}"/>

            <TabItem Header="Dashboard" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Get ready to play" FontSize="28" FontWeight="SemiBold"/>
                                <TextBlock Text="Four steps. Nothing changes without your OK." FontSize="15"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,18"/>
                                <UniformGrid Columns="4">
                                    <Border Style="{StaticResource Card}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0" Padding="18">
                                        <DockPanel>
                                            <Button x:Name="QuickCheckButton" DockPanel.Dock="Bottom" Content="Check my connection" ContentTemplate="{StaticResource IconContent}"
                                                    Tag="&#xE768;" Click="QuickCheck_Click" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" Margin="0,16,0,0"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <TextBlock Text="1" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="Check" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                                <views:BusySpinner x:Name="QuickCheckSpinner" Width="44" Height="44" Visibility="Collapsed"
                                                                   HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                                <TextBlock x:Name="QuickCheckStatusText" Text="Test your connection." FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0" Padding="18">
                                        <DockPanel>
                                            <Button x:Name="QuickPresetButton" DockPanel.Dock="Bottom" Content="Apply gaming preset" ContentTemplate="{StaticResource IconContent}"
                                                    Tag="&#xE945;" Click="QuickPreset_Click" Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" Margin="0,16,0,0"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <TextBlock Text="2" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="Improve" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                                <TextBlock x:Name="QuickPresetStatusText" Text="You review the changes first." FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0" Padding="18">
                                        <DockPanel>
                                            <Button x:Name="QuickRestartButton" DockPanel.Dock="Bottom" Content="Restart Windows…" ContentTemplate="{StaticResource IconContent}"
                                                    Tag="&#xE777;" Click="QuickRestart_Click"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" Margin="0,16,0,0"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <TextBlock Text="3" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="Restart" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                                <TextBlock x:Name="QuickRestartStatusText" Text="Only if the preset asks for it." FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="18">
                                        <DockPanel>
                                            <Button x:Name="QuickCompareButton" DockPanel.Dock="Bottom" Content="Did it help?" ContentTemplate="{StaticResource IconContent}"
                                                    Tag="&#xE895;" Click="ReRunAndCompare_Click" IsEnabled="{Binding IsEnabled, ElementName=ReRunDiagnosticButton}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" Margin="0,16,0,0"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <TextBlock Text="4" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="Play" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                                <TextBlock x:Name="QuickPlayStatusText" Text="Not checked yet." FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"
                                                           AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Health check" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HealthSummaryText" Text="Runs automatically with every inventory refresh." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="OpenHealthSectionButton" Content="Open the section that fixes this" ContentTemplate="{StaticResource IconContent}" Tag="&#xE8A7;"
                                            Click="OpenHealthSection_Click" IsEnabled="False" VerticalAlignment="Top"/>
                                </Grid>
                                <!-- These rows are the point of the dashboard, so they wrap instead of
                                     clipping: an evidence line cut at "Configured: 8.8.8.8, 8.8.4.4, 19"
                                     is worse than no line at all. Double-click opens the fixing section. -->
                                <Expander Header="Show all findings" Margin="0,12,0,0" AutomationProperties.Name="All health findings">
                                <DataGrid x:Name="HealthGrid" AutoGenerateColumns="False" MinHeight="120" Margin="0,12,0,0"
                                          RowHeight="NaN" MinRowHeight="40"
                                          SelectionChanged="HealthGrid_SelectionChanged"
                                          MouseDoubleClick="HealthGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding SeverityBadge}" Width="130"
                                                            ElementStyle="{StaticResource VerdictCellText}"/>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="2*" MinWidth="130"
                                                            ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" MinWidth="130"
                                                            ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="What to do" Binding="{Binding Action}" Width="3*" MinWidth="130"
                                                            ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Undo" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RecoverySummaryText" Text="No successful change is waiting to be undone."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,12,0"/>
                                    <TextBlock x:Name="WorkflowWriteStateText" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,6,12,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="UndoLastChangeButton" Content="Undo last successful change" ContentTemplate="{StaticResource IconContent}" Tag="&#xE7A7;"
                                            Click="UndoLastChange_Click" IsEnabled="False" Margin="0,0,8,0"/>
                                    <Button Content="Check for drift" ContentTemplate="{StaticResource IconContent}" Tag="&#xE9D9;" Click="DashboardCheckDrift_Click" Margin="0,0,8,0"/>
                                    <Button Content="Open recovery history" ContentTemplate="{StaticResource IconContent}" Tag="&#xE81C;" Click="OpenTuningPlan_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Expander Header="Details" Margin="0,18,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="Dashboard details">
                            <StackPanel Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE ADAPTERS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ActiveAdaptersText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="NETWORK DEVICES" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AdapterCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="LOGICAL PROCESSORS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ProcessorCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="NDIS PARAMETERS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="NdisPropertyCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PRIVILEGE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PrivilegeText" Text="—" FontSize="17" FontWeight="Bold" Margin="0,13,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Network quality" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DashboardNetworkSummaryText"
                                           Text="Run Gaming diagnostics or a passive Wi-Fi observation to populate these charts."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,16"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="280"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition MinWidth="280"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GAME ENDPOINT LATENCY" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" Margin="0,8,0,8" Padding="8">
                                            <Viewbox Stretch="Fill" Height="120">
                                                <Canvas x:Name="DashboardLatencyCanvas" Width="600" Height="120" ClipToBounds="True"
                                                        AutomationProperties.Name="Game endpoint latency chart"/>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock x:Name="DashboardLatencyLegendText" Text="No completed latency measurement"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WI-FI ASSOCIATION" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" Margin="0,8,0,8" Padding="8">
                                            <Viewbox Stretch="Fill" Height="120">
                                                <Canvas x:Name="DashboardWifiCanvas" Width="600" Height="120" ClipToBounds="True"
                                                        AutomationProperties.Name="Wi-Fi signal and negotiated rate chart"/>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock x:Name="DashboardWifiLegendText" Text="No passive Wi-Fi observation"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Border Style="{StaticResource Card}" >
                                <StackPanel>
                                    <TextBlock Text="System baseline" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Current read-only system facts. No setting is changed during discovery." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Operating system" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,16,5"/>
                                        <TextBlock x:Name="OsText" Grid.Column="1" Text="Loading…" Margin="0,5"/>
                                        <TextBlock Grid.Row="1" Text="Build" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,16,5"/>
                                        <TextBlock x:Name="BuildText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,5"/>
                                        <TextBlock Grid.Row="2" Text="Computer" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,16,5"/>
                                        <TextBlock x:Name="MachineText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,5"/>
                                        <TextBlock Grid.Row="3" Text="Captured" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,16,5"/>
                                        <TextBlock x:Name="CapturedText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Measure" Style="{StaticResource NavGroupHeader}"/>

            <TabItem Header="Gaming diagnostics">
                <TabControl x:Name="DiagnosisTabs" Style="{StaticResource PivotTabControl}">
                    <TabItem Header="Diagnosis">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                <StackPanel Width="260" Margin="0,0,12,12">
                                    <TextBlock Text="ENDPOINT" Style="{StaticResource FieldLabelText}"/>
                                    <TextBox x:Name="DiagnosticTargetText" Margin="0,6,0,0" Style="{StaticResource PlaceholderBox}"
                                             Tag="Host name or IP"
                                             ToolTip="The game server or regional endpoint to measure. A host name or an IP address."
                                             AutomationProperties.Name="Game or regional endpoint"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,12">
                                    <TextBlock Text="GAME (TICK RATE)" Style="{StaticResource FieldLabelText}"/>
                                    <ComboBox x:Name="DiagnosticGameComboBox" Margin="0,6,0,0"
                                              ToolTip="Sets the probe's packet size and the thresholds the result is judged against"
                                              AutomationProperties.Name="Game tick rate profile">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="RunDiagnosticButton" Content="Run complete check" ContentTemplate="{StaticResource IconContent}" Tag="&#xE768;" Click="RunDiagnostic_Click"
                                        VerticalAlignment="Bottom" Margin="0,0,8,12" Style="{StaticResource PrimaryButton}"
                                        ToolTip="Runs the read-only inventory and path checks together. Loaded-latency and throughput tests stay separate because they generate traffic."/>
                                <Button x:Name="CancelDiagnosticButton" Content="Cancel" ContentTemplate="{StaticResource IconContent}" Tag="&#xE711;" Click="CancelDiagnostic_Click"
                                        VerticalAlignment="Bottom" Margin="0,0,0,12" IsEnabled="False"/>
                                                            </WrapPanel>
                                <Expander Header="Advanced options" AutomationProperties.Name="Advanced diagnostic options">
                                    <WrapPanel Margin="0,8,0,0">
                                <StackPanel Width="140" Margin="0,0,12,12">
                                    <TextBlock Text="PROFILE" Style="{StaticResource FieldLabelText}"/>
                                    <ComboBox x:Name="DiagnosticProfileComboBox" Margin="0,6,0,0"
                                              AutomationProperties.Name="Diagnostic profile">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,12,12">
                                    <TextBlock Text="LOAD" Style="{StaticResource FieldLabelText}"/>
                                    <ComboBox x:Name="DiagnosticLoadComboBox" Margin="0,6,0,0" AutomationProperties.Name="Load condition"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,12,12">
                                    <TextBlock Text="TCP PORT (OPTIONAL)" Style="{StaticResource FieldLabelText}"/>
                                    <TextBox x:Name="DiagnosticPortText" Margin="0,6,0,0" Style="{StaticResource PlaceholderBox}"
                                             Tag="e.g. 7777" ToolTip="Only verifies TCP connection setup"
                                             AutomationProperties.Name="Optional TCP port"/>
                                </StackPanel>
                                <StackPanel Width="260" Margin="0,0,12,12" VerticalAlignment="Bottom">
                                    <CheckBox x:Name="CaptureDpcIsrCheckBox" Content="Also capture driver interrupt activity (DPC/ISR)"
                                              ToolTip="Measures which driver held the CPU longest during this check, the same figure LatencyMon reports. Needs administrator rights — a UAC prompt appears on this run only."
                                              AutomationProperties.Name="Capture driver interrupt activity"/>
                                </StackPanel>
                                    </WrapPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Playable?" FontSize="20" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                ToolTip="The same measurement means different things to different games. A server updating 128 times a second cannot place an input that arrives 10 ms out of position, while one updating 20 times a second will not notice it — so the jitter limits here are derived from the selected tick rate rather than chosen, and the verdict is the worst of the three numbers, never their average."/>
                                <TextBlock x:Name="PlayabilityHeadlineText" Text="Not run" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PlayabilityDetailText" Text="Run a diagnosis to judge the game endpoint against a tick rate."
                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <Expander Header="The numbers behind this" Margin="0,10,0,0" AutomationProperties.Name="Playability numbers">
                                <StackPanel>
                                <DataGrid x:Name="PlayabilityMetricsGrid" AutoGenerateColumns="False" Margin="0,8,0,0" MaxHeight="190" RowHeight="NaN" MinRowHeight="40"
                                          Style="{StaticResource ResultGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="110" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Verdict" Binding="{Binding GradeBadge}" Width="160" ElementStyle="{StaticResource VerdictCellText}"/>
                                        <DataGridTextColumn Header="Measured" Binding="{Binding Measured}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Budget for this tick rate" Binding="{Binding Budget}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="PlayabilityTickText" Text="" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Expander Header="More tools: compare, import, monitor" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="More diagnostic tools">
                            <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Did the change help?" FontSize="18" FontWeight="SemiBold"/>
                                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,0"
                                                        ToolTip="Applying a setting proves nothing on its own. Run a diagnosis, apply a plan, then re-run this identical diagnosis: the two are compared against what this path can actually resolve, so a difference smaller than the measurement's own noise is reported as no difference rather than as a win."/>
                                    </StackPanel>
                                    <Button x:Name="ReRunDiagnosticButton" Grid.Column="1" Content="Re-run and compare" ContentTemplate="{StaticResource IconContent}" Tag="&#xE895;"
                                            Click="ReRunAndCompare_Click" IsEnabled="False" VerticalAlignment="Top"
                                            Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                                            ToolTip="Repeats the diagnosis with exactly the parameters of the baseline run"/>
                                    <Button x:Name="ClearBaselineButton" Grid.Column="2" Content="Forget baseline" ContentTemplate="{StaticResource IconContent}" Tag="&#xE74D;"
                                            Click="ClearBaseline_Click" IsEnabled="False" VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock x:Name="VerificationHeadlineText" Text="No baseline yet."
                                           FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="VerificationDetailText"
                                           Text="Run a diagnosis, then apply a plan. The run from before the change becomes the baseline automatically."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <DataGrid x:Name="VerificationGrid" AutoGenerateColumns="False" Margin="0,12,0,0"
                                          MaxHeight="200" RowHeight="NaN" MinRowHeight="36"
                                          Style="{StaticResource ResultGrid}"
                                          AutomationProperties.Name="Before and after the applied change">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Verdict" Binding="{Binding VerdictBadge}" Width="130"
                                                            ElementStyle="{StaticResource VerdictCellText}"/>
                                        <DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="160" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Before and after" Binding="{Binding Display}" Width="*" MinWidth="220"
                                                            ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Import a capture report" FontSize="18" FontWeight="SemiBold"/>
                                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,0"
                                                        ToolTip="A packet capture knows the one thing this app cannot work out on its own: which server the game actually talked to, and how its packets were spaced. Import the report and SockTuner measures that endpoint itself rather than taking the numbers on trust."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Import report…" ContentTemplate="{StaticResource IconContent}" Tag="&#xE8B5;" Click="ImportGameReport_Click" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                    <Button x:Name="UseReportTargetButton" Grid.Column="2" Content="Use this endpoint" ContentTemplate="{StaticResource IconContent}" Tag="&#xE73E;"
                                            Click="UseReportTarget_Click" IsEnabled="False" VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock x:Name="ImportedReportText" Text="No report imported." Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <DataGrid x:Name="ImportedFindingsGrid" AutoGenerateColumns="False" MaxHeight="220" Margin="0,10,0,0"
                                          RowHeight="NaN" MinRowHeight="40" Visibility="Collapsed">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding SeverityBadge}" Width="130" ElementStyle="{StaticResource VerdictCellText}"/>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="What to do" Binding="{Binding Action}" Width="3*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Continuous monitor" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <TextBox x:Name="MonitorDurationText" Grid.Column="1" Text="30" AutomationProperties.Name="Monitor duration seconds"/>
                                <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                <TextBox x:Name="MonitorIntervalText" Grid.Column="3" Text="1000" AutomationProperties.Name="Monitor interval milliseconds"/>
                                <TextBlock Grid.Column="4" Text="ms" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <Button x:Name="MonitorStartButton" Content="Start" ContentTemplate="{StaticResource IconContent}" Tag="&#xE768;" Click="StartMonitor_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="MonitorStopButton" Content="Stop" ContentTemplate="{StaticResource IconContent}" Tag="&#xE71A;" Click="StopMonitor_Click" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="MonitorStatusText" Grid.Column="6" Text="Not running" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Border>
                            </StackPanel>
                        </Expander>

                        <!-- The probe targets read left to right as the path a packet takes, so the first
                             segment that looks wrong is where the trouble starts. -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="GATEWAY" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/><TextBlock x:Name="GatewayResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="REFERENCE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/><TextBlock x:Name="ReferenceResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Border Grid.Column="4" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="GAME ENDPOINT" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/><TextBlock x:Name="GameResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="DNS / CONNECTION" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/><TextBlock x:Name="DnsResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Where the problem starts" FontSize="20" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                ToolTip="Walks outward — adapter, LAN, router, ISP, external hop, endpoint — and stops at the first segment that degrades relative to the one before it."/>
                                <TextBlock x:Name="BottleneckResultText" Text="Not run" TextWrapping="Wrap" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Path shape" FontSize="20" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                ToolTip="NAT layers and path-MTU behaviour. Neither shows up in a latency measurement, and both explain whole classes of report — port forwarding that will not work, or downloads that stall while ping is fine."/>
                                <TextBlock x:Name="TopologyResultText" Text="Not run" TextWrapping="Wrap" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Evidence-ranked findings" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DiagnosticRunSummaryText" Text="Run a diagnosis to populate findings." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="Export report JSON" ContentTemplate="{StaticResource IconContent}" Tag="&#xEDE1;" Click="ExportReportJson_Click" Margin="0,0,8,0"/>
                                    <Button Content="Export report HTML" ContentTemplate="{StaticResource IconContent}" Tag="&#xEDE1;" Click="ExportReportHtml_Click" Margin="0,0,8,0"/>
                                    <Button Content="Export redacted HTML" ContentTemplate="{StaticResource IconContent}" Tag="&#xEDE1;" Click="ExportRedactedReportHtml_Click"/>
                                </StackPanel>
                                <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" MinHeight="190" RowHeight="NaN" MinRowHeight="40"
                                          Style="{StaticResource ResultGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="1.3*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Per-probe rows are evidence for the verdicts above, not the verdicts themselves:
                             folded away so the page reads as an answer first. -->
                        <Expander Header="Raw measurements" Margin="0,18,0,0" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Raw measurements">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Probe statistics" FontSize="20" FontWeight="SemiBold"/>
                                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                        ToolTip="Jitter is the mean absolute difference between consecutive successful RTT samples, so it moves with how fast the profile sent. Jitter (1s) is the standard deviation inside each one-second window, averaged — the same line reports the same figure at any probe rate, which is the one that can be compared against a game's tick budget. It is blank when no single second collected two replies."/>
                                        <DataGrid x:Name="DiagnosticStatisticsGrid" AutoGenerateColumns="False" MinHeight="150">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Target" Binding="{Binding Label}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="60" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="75" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Lost" Binding="{Binding Lost}" Width="60" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Min" Binding="{Binding MinimumMs}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Median" Binding="{Binding MedianMs}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Average" Binding="{Binding AverageMs}" Width="75" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="P95" Binding="{Binding P95Ms}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="P99" Binding="{Binding P99Ms}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Max" Binding="{Binding MaximumMs}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Jitter" Binding="{Binding JitterMs}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Jitter (1s)" Binding="{Binding WindowedJitterMs}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Spikes" Binding="{Binding SpikeSamples.Count}" Width="65" ElementStyle="{StaticResource WrapCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Probe and spike timeline" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                        <DataGrid x:Name="DiagnosticSamplesGrid" AutoGenerateColumns="False" MinHeight="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Target" Binding="{Binding Label}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="RTT ms" Binding="{Binding RoundTripTimeMs}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridCheckBoxColumn Header="Spike" Binding="{Binding IsSpike}" Width="65"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding FailureKind}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Repeated route samples" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                        <DataGrid x:Name="RouteSamplesGrid" AutoGenerateColumns="False" MinHeight="120">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Hops" Binding="{Binding HopsDisplay}" Width="3*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding FailureKind}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Detail" Binding="{Binding Error}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Monitoring timeline" FontSize="20" FontWeight="SemiBold"/>
                                        <DataGrid x:Name="MonitorSamplesGrid" AutoGenerateColumns="False" MinHeight="190" Margin="0,12,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Target" Binding="{Binding Label}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Address" Binding="{Binding Target}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Result" Binding="{Binding ResultDisplay}" Width="130" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding Kind}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Detail" Binding="{Binding Error}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Recommendations">
                        <views:RecommendationsView x:Name="Recommendations"/>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Game ports &amp; NAT">
                <views:NatDiagnosticsView x:Name="NatDiagnostics"/>
            </TabItem>

            <TabItem Header="Wi-Fi diagnostics">
                <views:WifiDiagnosticsView x:Name="WifiDiagnostics"/>
            </TabItem>

            <TabItem Header="Host diagnostics">
                <views:HostDiagnosticsView x:Name="HostDiagnostics"/>
            </TabItem>

            <TabItem Header="Throughput &amp; bufferbloat">
                <views:ThroughputView x:Name="Throughput"/>
            </TabItem>

            <TabItem Header="DNS resolvers">
                <views:DnsResolversView x:Name="DnsResolvers"/>
            </TabItem>

            <TabItem Header="Act" Style="{StaticResource NavGroupHeader}"/>

            <TabItem Header="Tuning plan">
                <views:TuningPlanView x:Name="TuningPlan"/>
            </TabItem>

            <TabItem Header="Interfaces">
                <views:InterfacesView x:Name="Interfaces"/>
            </TabItem>

            <TabItem Header="Interrupt affinity">
                <views:InterruptAffinityView x:Name="InterruptAffinity"/>
            </TabItem>

            <TabItem Header="Records" Style="{StaticResource NavGroupHeader}"/>

            <!-- Nine expert inventory tables are one destination with sub-pages: a first-time
                 user sees ten places to go instead of eighteen. Headers stay the section names
                 that health findings route to; FindSection looks inside this control too. -->
            <TabItem Header="Network details">
                <TabControl x:Name="DetailsTabs" Style="{StaticResource PivotTabControl}">
                    <TabItem Header="Adapters">
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Network adapters" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="Stable identity, state, link speed, addresses, gateways, and protocol support." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <TextBox x:Name="AdapterFilterText" Grid.Column="1" Margin="12,0" VerticalAlignment="Bottom"
                                         Style="{StaticResource PlaceholderBox}" Tag="Filter adapters"
                                         TextChanged="AdapterFilter_TextChanged"
                                         AutomationProperties.Name="Filter network adapters"/>
                                <Button Grid.Column="2" Content="Copy as text" ContentTemplate="{StaticResource IconContent}" Tag="&#xE8C8;" Click="CopyAdapter_Click" VerticalAlignment="Bottom"
                                        ToolTip="Copies the selected adapter as tab-separated text"/>
                            </Grid>
                            <DataGrid x:Name="AdaptersGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding AdapterKindDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding InterfaceType}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Speed" Binding="{Binding SpeedDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="MTU" Binding="{Binding MtuDisplay}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverDisplay}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="NDIS" Binding="{Binding NdisPropertyCountDisplay}" Width="105" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Protocols" Binding="{Binding ProtocolsDisplay}" Width="110" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Inventory" Binding="{Binding InventoryStatus}" Width="160" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Addresses" Binding="{Binding AddressesDisplay}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="NDIS &amp; drivers">
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Driver-advertised NDIS properties" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="NdisSummaryText" Text="Reading native driver metadata…"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBox x:Name="NdisFilterText" Grid.Column="1" Margin="12,0" VerticalAlignment="Bottom"
                                         Style="{StaticResource PlaceholderBox}" Tag="Filter keywords"
                                         TextChanged="NdisFilter_TextChanged"
                                         AutomationProperties.Name="Filter NDIS properties"/>
                                <Button Grid.Column="2" Content="Copy as text" ContentTemplate="{StaticResource IconContent}" Tag="&#xE8C8;" Click="CopyNdisProperty_Click" VerticalAlignment="Bottom"
                                        ToolTip="Copies the selected property as tab-separated text"/>
                            </Grid>
                            <DataGrid x:Name="NdisPropertiesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adapter" Binding="{Binding Adapter}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Provider / version" Binding="{Binding Driver}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Keyword" Binding="{Binding Keyword}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="110" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Default" Binding="{Binding Default}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Driver-advertised values" Binding="{Binding ValidValues}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Routes &amp; DNS">
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="2*"/>
                                <RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="IP route table" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RouteSummaryText" Text="Reading native route inventory…"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid x:Name="RoutesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Family" Binding="{Binding AddressFamily}" Width="75" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Next hop" Binding="{Binding NextHop}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Index" Binding="{Binding InterfaceIndex}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="4">
                                <TextBlock Text="Interface addressing and metrics" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="InterfaceSummaryText" Text="Reading native interface metrics…"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <DataGrid x:Name="DnsInterfacesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="6" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="IPv4 index" Binding="{Binding Ipv4Index}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="MTU" Binding="{Binding MtuDisplay}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="IP metrics" Binding="{Binding MetricDisplay}" Width="240" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Default routes" Binding="{Binding DefaultRoutePolicyDisplay}" Width="210" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Received" Binding="{Binding ReceivedDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Sent" Binding="{Binding SentDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Receive issues" Binding="{Binding ReceiveIssuesDisplay}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Send issues" Binding="{Binding SendIssuesDisplay}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Gateways" Binding="{Binding GatewaysDisplay}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="DNS servers" Binding="{Binding DnsDisplay}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Network profiles">
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Windows network profiles" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NetworkProfileSummaryText" Text="Reading Network List Manager…"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid x:Name="NetworkProfilesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Domain" Binding="{Binding DomainType}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="110" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Connectivity" Binding="{Binding ConnectivityDisplay}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Adapter ID" Binding="{Binding AdapterId}" Width="260" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Network ID" Binding="{Binding NetworkId}" Width="260" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Network bindings">
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Adapter protocol and filter bindings" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BindingSummaryText" Text="Reading StandardCimv2 binding state…"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid x:Name="BindingsGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Interface description" Binding="{Binding InterfaceDescription}" Width="220" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Component" Binding="{Binding DisplayName}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Component ID" Binding="{Binding ComponentId}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding StateDisplay}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Class" Binding="{Binding ComponentClassName}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Bind name" Binding="{Binding BindName}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Adapter ID" Binding="{Binding AdapterId}" Width="260" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Class ID" Binding="{Binding ComponentClassGuid}" Width="260" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Characteristics" Binding="{Binding CharacteristicsDisplay}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Offloads">
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="RSS, RSC and hardware offload state" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OffloadSummaryText" Text="Reading StandardCimv2 offload state…"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid x:Name="GlobalOffloadsGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" MaxHeight="190" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Global feature" Binding="{Binding Feature}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="160" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Raw value" Binding="{Binding RawValue}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="AdapterOffloadsGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="4" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="160" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Feature" Binding="{Binding Feature}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="IPv4" Binding="{Binding Ipv4State}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="IPv6" Binding="{Binding Ipv6State}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Adapter ID" Binding="{Binding AdapterId}" Width="260" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Interface description" Binding="{Binding InterfaceDescription}" Width="220" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="TCP settings">
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="TCP templates and effective policy" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TcpSettingSummaryText" Text="Reading StandardCimv2 TCP settings…"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid x:Name="TcpSettingsGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Template" Binding="{Binding SettingName}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Auto-tuning" Binding="{Binding AutoTuningDisplay}" Width="260" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Congestion" Binding="{Binding CongestionDisplay}" Width="110" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="ECN" Binding="{Binding EcnDisplay}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Timestamps" Binding="{Binding TimestampsDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Dynamic ports" Binding="{Binding DynamicPortRangeDisplay}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Timing" Binding="{Binding TimingDisplay}" Width="330" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Initial cwnd" Binding="{Binding InitialCongestionWindow}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="SYN retries" Binding="{Binding MaxSynRetransmissions}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Other state" Binding="{Binding OtherFlagsDisplay}" Width="460" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Automatic custom" Binding="{Binding AutomaticUseCustomDisplay}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="QoS policies">
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Windows QoS policy inventory" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="QosPolicySummaryText" Text="Reading StandardCimv2 QoS policies…"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Mark one application's traffic" FontSize="18" FontWeight="SemiBold"/>
                                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                        ToolTip="A DSCP mark is a request, not a reservation. It does nothing until something on the path is set up to honour it — in practice your own router, with a DSCP-aware queue discipline; most consumer ISPs rewrite or ignore the field beyond your access link. This is the half that makes SockTuner's layer_cake.qos advice usable: the policy writes the mark, the router acts on it."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="Running application" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <ComboBox x:Name="QosRunningApplicationComboBox" Width="280"
                                                      DropDownOpened="QosRunningApplication_DropDownOpened"
                                                      SelectionChanged="QosRunningApplication_SelectionChanged"
                                                      AutomationProperties.Name="Choose a running application"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="APPLICATION" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                                <TextBox x:Name="QosApplicationText" Margin="0,6,0,0"
                                                         Style="{StaticResource PlaceholderBox}" Tag="game.exe"
                                                         ToolTip="The executable name Windows should match, or its full path"
                                                         AutomationProperties.Name="Application to mark"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="PROTOCOL" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                                <ComboBox x:Name="QosProtocolComboBox" Margin="0,6,0,0"
                                                          AutomationProperties.Name="Protocol"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                <TextBlock Text="REMOTE PORTS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                                <TextBox x:Name="QosPortsText" Text="*" Margin="0,6,0,0"
                                                         ToolTip="A port, a range such as 7000-8000, or * for all"
                                                         AutomationProperties.Name="Remote ports"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                                <TextBlock Text="DSCP" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                                <TextBox x:Name="QosDscpText" Text="46" Margin="0,6,0,0"
                                                         ToolTip="0 to 63. 46 is Expedited Forwarding, the conventional mark for interactive traffic."
                                                         AutomationProperties.Name="DSCP value"/>
                                            </StackPanel>
                                            <Button Grid.Column="4" Content="Queue policy" ContentTemplate="{StaticResource IconContent}" Tag="&#xE710;" Click="QueueQosPolicy_Click"
                                                    VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}"/>
                                        </Grid>
                                        <TextBlock x:Name="QosActionStatusText" Text="Nothing queued."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Remove a SockTuner policy" ContentTemplate="{StaticResource IconContent}" Tag="&#xE74D;" Click="QueueRemoveQosPolicy_Click"
                                                    Margin="0,0,8,0"
                                                    ToolTip="Queues the removal of the policy named for the application above. SockTuner only manages policies it created."/>
                                            <Button Content="Go to tuning plan" ContentTemplate="{StaticResource IconContent}" Tag="&#xE72A;" Click="OpenTuningPlan_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <DataGrid x:Name="QosPoliciesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Profile" Binding="{Binding ProfileDisplay}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Precedence" Binding="{Binding Precedence}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Conditions" Binding="{Binding ConditionsDisplay}" Width="3*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Actions" Binding="{Binding ActionsDisplay}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Winsock catalog">
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Winsock protocol providers" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WinsockSummaryText" Text="Reading native Winsock catalog…"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataGrid x:Name="WinsockProvidersGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Catalog ID" Binding="{Binding CatalogEntryId}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Provider" Binding="{Binding Name}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Family" Binding="{Binding AddressFamilyDisplay}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Socket" Binding="{Binding SocketTypeDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Chain" Binding="{Binding ChainDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Provider ID" Binding="{Binding ProviderId}" Width="260" ElementStyle="{StaticResource WrapCellText}"/>
                                    <DataGridTextColumn Header="Flags" Binding="{Binding FlagsDisplay}" Width="260" ElementStyle="{StaticResource WrapCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="History &amp; comparison">
                <views:HistoryView x:Name="History"/>
            </TabItem>

            <TabItem Header="Tools &amp; references">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,0"
                                        ToolTip="The measurements worth checking a SockTuner result against, and the tools this app deliberately does not replace."/>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Reference tools and reading" FontSize="18" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                ToolTip="Opened in your browser. SockTuner bundles no third-party binaries and downloads nothing: these are where to get the tools it does not replace, and the measurement services worth checking a result against."/>
                                <ItemsControl x:Name="ReferenceLinkList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Title}" ToolTip="{Binding Url}" Tag="{Binding Url}"
                                                    Click="OpenReference_Click" Margin="0,0,8,8" Padding="14,6"
                                                    AutomationProperties.Name="{Binding Title}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ReferenceStatusText" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Preferences">
                <views:PreferencesView x:Name="Preferences"/>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="20,6,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="LogStatusText" Grid.Column="2" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,18,0"/>
            <TextBlock Grid.Column="3" Text="COMMUNITY ALPHA 0.9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
