<Window x:Class="SockTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SockTuner" Icon="Assets/SockTuner.ico" Height="820" Width="1320" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindowStyle}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="28,22,28,18" Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="SockTuner" FontSize="30" FontWeight="Light"/>
                <TextBlock Text="Windows network control and gaming diagnostics" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <TextBox x:Name="InventoryFilterText" Width="170" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         TextChanged="InventoryFilter_TextChanged" AutomationProperties.Name="Search all inventory"/>
                <Button Content="Copy selected" Click="CopyInventorySelected_Click" Margin="0,0,8,0"/>
                <Button Content="Export snapshot" Click="ExportSnapshot_Click" Margin="0,0,8,0"/>
                <Button Content="Export support snapshot" Click="ExportSupportSnapshot_Click" Margin="0,0,8,0"/>
                <Button Content="Export logs" Click="ExportLogs_Click" Margin="0,0,12,0"/>
                <Border Background="{StaticResource PrimaryMutedBrush}" BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="READ-ONLY PREVIEW" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>

        <TabControl x:Name="InventoryTabs" Grid.Row="2" SelectionChanged="InventoryTabs_SelectionChanged">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE ADAPTERS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ActiveAdaptersText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="NETWORK DEVICES" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AdapterCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="LOGICAL PROCESSORS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ProcessorCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="NDIS PARAMETERS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="NdisPropertyCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PRIVILEGE" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PrivilegeText" Text="—" FontSize="17" FontWeight="Bold" Margin="0,13,0,0" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="System baseline" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Current read-only system facts. No setting is changed during discovery." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Operating system" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                                        <TextBlock x:Name="OsText" Grid.Column="1" Text="Loading…" Margin="0,5"/>
                                        <TextBlock Grid.Row="1" Text="Build" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                                        <TextBlock x:Name="BuildText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,5"/>
                                        <TextBlock Grid.Row="2" Text="Computer" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                                        <TextBlock x:Name="MachineText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,5"/>
                                        <TextBlock Grid.Row="3" Text="Captured" Foreground="{StaticResource MutedTextBrush}" Margin="0,5"/>
                                        <TextBlock x:Name="CapturedText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Safe workflow" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="1  Inspect the current state" Margin="0,18,0,8"/>
                                    <TextBlock Text="2  Diagnose each network boundary" Margin="0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="3  Preview a typed change plan" Margin="0,8"/>
                                    <TextBlock Text="4  Snapshot, apply, verify, roll back" Margin="0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="Mutations remain disabled in this preview build." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Adapters">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Network adapters" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Stable identity, state, link speed, addresses, gateways, and protocol support." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="SEARCH" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            <TextBox x:Name="AdapterFilterText" TextChanged="AdapterFilter_TextChanged" Margin="0,5,0,0"
                                     AutomationProperties.Name="Filter network adapters"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Copy selected" Click="CopyAdapter_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Content="Refresh inventory" Click="RefreshInventory_Click" VerticalAlignment="Bottom"
                                Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Refresh network inventory"/>
                    </Grid>
                    <DataGrid x:Name="AdaptersGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding AdapterKindDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding InterfaceType}" Width="140"/>
                            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedDisplay}" Width="100"/>
                            <DataGridTextColumn Header="MTU" Binding="{Binding MtuDisplay}" Width="120"/>
                            <DataGridTextColumn Header="Driver" Binding="{Binding DriverDisplay}" Width="180"/>
                            <DataGridTextColumn Header="NDIS" Binding="{Binding NdisPropertyCountDisplay}" Width="105"/>
                            <DataGridTextColumn Header="Protocols" Binding="{Binding ProtocolsDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Inventory" Binding="{Binding InventoryStatus}" Width="160"/>
                            <DataGridTextColumn Header="Addresses" Binding="{Binding AddressesDisplay}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="NDIS &amp; drivers">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Driver-advertised NDIS properties" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="NdisSummaryText" Text="Reading native driver metadata…"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="SEARCH" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            <TextBox x:Name="NdisFilterText" TextChanged="NdisFilter_TextChanged" Margin="0,5,0,0"
                                     AutomationProperties.Name="Filter NDIS properties"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Copy selected" Click="CopyNdisProperty_Click" VerticalAlignment="Bottom"/>
                    </Grid>
                    <DataGrid x:Name="NdisPropertiesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Adapter" Binding="{Binding Adapter}" Width="140"/>
                            <DataGridTextColumn Header="Provider / version" Binding="{Binding Driver}" Width="180"/>
                            <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="180"/>
                            <DataGridTextColumn Header="Keyword" Binding="{Binding Keyword}" Width="150"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="110"/>
                            <DataGridTextColumn Header="Default" Binding="{Binding Default}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                            <DataGridTextColumn Header="Driver-advertised values" Binding="{Binding ValidValues}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Routes &amp; DNS">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="2*"/>
                        <RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="IP route table" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RouteSummaryText" Text="Reading native route inventory…"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="RoutesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Family" Binding="{Binding AddressFamily}" Width="75"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="190"/>
                            <DataGridTextColumn Header="Next hop" Binding="{Binding NextHop}" Width="140"/>
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="180"/>
                            <DataGridTextColumn Header="Index" Binding="{Binding InterfaceIndex}" Width="80"/>
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="80"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Interface addressing and metrics" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="InterfaceSummaryText" Text="Reading native interface metrics…"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="DnsInterfacesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="6" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="IPv4 index" Binding="{Binding Ipv4Index}" Width="100"/>
                            <DataGridTextColumn Header="MTU" Binding="{Binding MtuDisplay}" Width="150"/>
                            <DataGridTextColumn Header="IP metrics" Binding="{Binding MetricDisplay}" Width="240"/>
                            <DataGridTextColumn Header="Default routes" Binding="{Binding DefaultRoutePolicyDisplay}" Width="210"/>
                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Sent" Binding="{Binding SentDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Receive issues" Binding="{Binding ReceiveIssuesDisplay}" Width="180"/>
                            <DataGridTextColumn Header="Send issues" Binding="{Binding SendIssuesDisplay}" Width="180"/>
                            <DataGridTextColumn Header="Gateways" Binding="{Binding GatewaysDisplay}" Width="2*"/>
                            <DataGridTextColumn Header="DNS servers" Binding="{Binding DnsDisplay}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Network profiles">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Windows network profiles" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NetworkProfileSummaryText" Text="Reading Network List Manager…"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="NetworkProfilesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Domain" Binding="{Binding DomainType}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="110"/>
                            <DataGridTextColumn Header="Connectivity" Binding="{Binding ConnectivityDisplay}" Width="2*"/>
                            <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="180"/>
                            <DataGridTextColumn Header="Adapter ID" Binding="{Binding AdapterId}" Width="260"/>
                            <DataGridTextColumn Header="Network ID" Binding="{Binding NetworkId}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Network bindings">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Adapter protocol and filter bindings" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BindingSummaryText" Text="Reading StandardCimv2 binding state…"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="BindingsGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="150"/>
                            <DataGridTextColumn Header="Interface description" Binding="{Binding InterfaceDescription}" Width="220"/>
                            <DataGridTextColumn Header="Component" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Component ID" Binding="{Binding ComponentId}" Width="150"/>
                            <DataGridTextColumn Header="State" Binding="{Binding StateDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding ComponentClassName}" Width="120"/>
                            <DataGridTextColumn Header="Bind name" Binding="{Binding BindName}" Width="150"/>
                            <DataGridTextColumn Header="Adapter ID" Binding="{Binding AdapterId}" Width="260"/>
                            <DataGridTextColumn Header="Class ID" Binding="{Binding ComponentClassGuid}" Width="260"/>
                            <DataGridTextColumn Header="Characteristics" Binding="{Binding CharacteristicsDisplay}" Width="120"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Offloads">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="RSS, RSC and hardware offload state" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OffloadSummaryText" Text="Reading StandardCimv2 offload state…"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="GlobalOffloadsGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" MaxHeight="190" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Global feature" Binding="{Binding Feature}" Width="2*"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="160"/>
                            <DataGridTextColumn Header="Raw value" Binding="{Binding RawValue}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="AdapterOffloadsGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="4" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="160"/>
                            <DataGridTextColumn Header="Feature" Binding="{Binding Feature}" Width="100"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/>
                            <DataGridTextColumn Header="IPv4" Binding="{Binding Ipv4State}" Width="2*"/>
                            <DataGridTextColumn Header="IPv6" Binding="{Binding Ipv6State}" Width="2*"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
                            <DataGridTextColumn Header="Adapter ID" Binding="{Binding AdapterId}" Width="260"/>
                            <DataGridTextColumn Header="Interface description" Binding="{Binding InterfaceDescription}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="TCP settings">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="TCP templates and effective policy" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TcpSettingSummaryText" Text="Reading StandardCimv2 TCP settings…"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="TcpSettingsGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Template" Binding="{Binding SettingName}" Width="140"/>
                            <DataGridTextColumn Header="Auto-tuning" Binding="{Binding AutoTuningDisplay}" Width="260"/>
                            <DataGridTextColumn Header="Congestion" Binding="{Binding CongestionDisplay}" Width="110"/>
                            <DataGridTextColumn Header="ECN" Binding="{Binding EcnDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Timestamps" Binding="{Binding TimestampsDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Dynamic ports" Binding="{Binding DynamicPortRangeDisplay}" Width="190"/>
                            <DataGridTextColumn Header="Timing" Binding="{Binding TimingDisplay}" Width="330"/>
                            <DataGridTextColumn Header="Initial cwnd" Binding="{Binding InitialCongestionWindow}" Width="100"/>
                            <DataGridTextColumn Header="SYN retries" Binding="{Binding MaxSynRetransmissions}" Width="90"/>
                            <DataGridTextColumn Header="Other state" Binding="{Binding OtherFlagsDisplay}" Width="460"/>
                            <DataGridTextColumn Header="Automatic custom" Binding="{Binding AutomaticUseCustomDisplay}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="QoS policies">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Windows QoS policy inventory" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="QosPolicySummaryText" Text="Reading StandardCimv2 QoS policies…"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="QosPoliciesGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="150"/>
                            <DataGridTextColumn Header="Profile" Binding="{Binding ProfileDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Precedence" Binding="{Binding Precedence}" Width="90"/>
                            <DataGridTextColumn Header="Conditions" Binding="{Binding ConditionsDisplay}" Width="3*"/>
                            <DataGridTextColumn Header="Actions" Binding="{Binding ActionsDisplay}" Width="2*"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Winsock catalog">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Winsock protocol providers" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WinsockSummaryText" Text="Reading native Winsock catalog…"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="WinsockProvidersGrid" SelectionChanged="InventoryGrid_SelectionChanged" Grid.Row="2" AutoGenerateColumns="False" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Catalog ID" Binding="{Binding CatalogEntryId}" Width="90"/>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Family" Binding="{Binding AddressFamilyDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Socket" Binding="{Binding SocketTypeDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Chain" Binding="{Binding ChainDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Provider ID" Binding="{Binding ProviderId}" Width="260"/>
                            <DataGridTextColumn Header="Flags" Binding="{Binding FlagsDisplay}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Gaming diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="GAME OR REGIONAL ENDPOINT" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBox x:Name="DiagnosticTargetText" Text="" Margin="0,6,0,0" ToolTip="Host name or IP address"
                                             AutomationProperties.Name="Game or regional endpoint"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="PROFILE" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <ComboBox x:Name="DiagnosticProfileComboBox" Margin="0,6,0,0" DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Diagnostic profile"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="LOAD" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <ComboBox x:Name="DiagnosticLoadComboBox" Margin="0,6,0,0" AutomationProperties.Name="Load condition"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                    <TextBlock Text="TCP PORT (OPTIONAL)" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBox x:Name="DiagnosticPortText" Margin="0,6,0,0" ToolTip="Only verifies TCP connection setup"
                                             AutomationProperties.Name="Optional TCP port"/>
                                </StackPanel>
                                <Button x:Name="RunDiagnosticButton" Grid.Column="4" Content="Run diagnosis" Click="RunDiagnostic_Click"
                                        VerticalAlignment="Bottom" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"/>
                                <Button x:Name="CancelDiagnosticButton" Grid.Column="5" Content="Cancel" Click="CancelDiagnostic_Click"
                                        VerticalAlignment="Bottom" IsEnabled="False"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="No test runs automatically. This is read-only network measurement; it never changes Windows or adapter settings." Foreground="{StaticResource PrimaryTextBrush}" Margin="4,12,0,0" TextWrapping="Wrap"/>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Continuous monitor" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <TextBox x:Name="MonitorDurationText" Grid.Column="1" Text="30" AutomationProperties.Name="Monitor duration seconds"/>
                                <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                <TextBox x:Name="MonitorIntervalText" Grid.Column="3" Text="1000" AutomationProperties.Name="Monitor interval milliseconds"/>
                                <TextBlock Grid.Column="4" Text="ms" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <Button x:Name="MonitorStartButton" Content="Start" Click="StartMonitor_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="MonitorStopButton" Content="Stop" Click="StopMonitor_Click" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="MonitorStatusText" Grid.Column="6" Text="Not running" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="GATEWAY" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="GatewayResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="REFERENCE" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="ReferenceResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="GAME ENDPOINT" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="GameResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="DNS / CONNECTION" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="DnsResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Probe statistics" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Jitter is the mean absolute difference between consecutive successful RTT samples." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,12"/>
                                <DataGrid x:Name="DiagnosticStatisticsGrid" AutoGenerateColumns="False" MinHeight="150">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Label}" Width="150"/>
                                        <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="60"/>
                                        <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="75"/>
                                        <DataGridTextColumn Header="Lost" Binding="{Binding Lost}" Width="60"/>
                                        <DataGridTextColumn Header="Min" Binding="{Binding MinimumMs}" Width="70"/>
                                        <DataGridTextColumn Header="Median" Binding="{Binding MedianMs}" Width="70"/>
                                        <DataGridTextColumn Header="Average" Binding="{Binding AverageMs}" Width="75"/>
                                        <DataGridTextColumn Header="P95" Binding="{Binding P95Ms}" Width="70"/>
                                        <DataGridTextColumn Header="P99" Binding="{Binding P99Ms}" Width="70"/>
                                        <DataGridTextColumn Header="Max" Binding="{Binding MaximumMs}" Width="70"/>
                                        <DataGridTextColumn Header="Jitter" Binding="{Binding JitterMs}" Width="70"/>
                                        <DataGridTextColumn Header="Spikes" Binding="{Binding SpikeSamples.Count}" Width="65"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Probe and spike timeline" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                <DataGrid x:Name="DiagnosticSamplesGrid" AutoGenerateColumns="False" MinHeight="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Label}" Width="150"/>
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190"/>
                                        <DataGridTextColumn Header="RTT ms" Binding="{Binding RoundTripTimeMs}" Width="90"/>
                                        <DataGridCheckBoxColumn Header="Spike" Binding="{Binding IsSpike}" Width="65"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding FailureKind}" Width="140"/>
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Repeated route samples" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                <DataGrid x:Name="RouteSamplesGrid" AutoGenerateColumns="False" MinHeight="120">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190"/>
                                        <DataGridTextColumn Header="Hops" Binding="{Binding HopsDisplay}" Width="3*"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding FailureKind}" Width="120"/>
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Error}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Evidence-ranked findings" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DiagnosticRunSummaryText" Text="Run a diagnosis to populate findings." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="Export report JSON" Click="ExportReportJson_Click" Margin="0,0,8,0"/>
                                    <Button Content="Export report HTML" Click="ExportReportHtml_Click" Margin="0,0,8,0"/>
                                    <Button Content="Export redacted HTML" Click="ExportRedactedReportHtml_Click"/>
                                </StackPanel>
                                <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" MinHeight="190">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120"/>
                                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100"/>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="1.3*"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*"/>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Monitoring timeline" FontSize="20" FontWeight="SemiBold"/>
                                <DataGrid x:Name="MonitorSamplesGrid" AutoGenerateColumns="False" MinHeight="190" Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190"/>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Label}" Width="140"/>
                                        <DataGridTextColumn Header="Address" Binding="{Binding Target}" Width="180"/>
                                        <DataGridTextColumn Header="Result" Binding="{Binding ResultDisplay}" Width="130"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding Kind}" Width="120"/>
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Error}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History &amp; comparison">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Diagnostic run history" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Select exactly two identical-parameter runs to compare." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
                        <Button Grid.Column="1" Content="Compare selected" Click="CompareHistory_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Trend selected" Click="TrendHistory_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Content="Export selected redacted" Click="ExportHistory_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="4" Content="Delete selected" Click="DeleteHistory_Click"/>
                    </Grid>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="2" AutoGenerateColumns="False" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Saved" Binding="{Binding SavedAt}" Width="190"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*"/>
                            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="110"/>
                            <DataGridTextColumn Header="Game summary" Binding="{Binding GameSummary}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ComparisonText" Grid.Row="4" Text="No comparison selected." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Preferences">
                <StackPanel Margin="0,20,0,0" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Local retention" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="SockTuner keeps the current log plus one rotated file. Choose the maximum size of each file."
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Log file size" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="LogRetentionComboBox" Width="150" SelectionChanged="LogRetention_SelectionChanged"
                                  AutomationProperties.Name="Maximum log file size"/>
                        <TextBlock Text="MB per file" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="PreferenceStatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Tuning plan">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Typed change-plan preview" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="Build a dry-run from allowlisted settings. Preview reads current values; this UI has no apply path." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource WarningMutedBrush}" BorderBrush="#E6C15A" BorderThickness="1" Padding="12,6">
                                    <TextBlock Text="LIVE WRITES LOCKED" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="TuningCatalogGrid" AutoGenerateColumns="False" Height="230" Margin="0,14,0,0" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Setting" Binding="{Binding Title}" Width="160"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="100"/>
                                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="100"/><DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="75"/>
                                <DataGridTextColumn Header="Restart" Binding="{Binding RestartRequirement}" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Trade-off" Binding="{Binding TradeOff}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Select a catalog row, target adapter when required, and proposed DWORD value." TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PlanAdapterComboBox" Grid.Column="1" Margin="10,0" DisplayMemberPath="Name" AutomationProperties.Name="Plan target adapter"/>
                                <TextBox x:Name="PlanValueText" Grid.Column="2" AutomationProperties.Name="Proposed value"/>
                                <Button Grid.Column="3" Content="Add to cart" Click="AddPlanItem_Click" Margin="8,0"/>
                                <Button Grid.Column="4" Content="Clear" Click="ClearPlan_Click"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="PlanCartGrid" AutoGenerateColumns="False" Height="150" Margin="0,14,0,0" IsReadOnly="True" CanUserDeleteRows="False">
                            <DataGrid.Columns><DataGridTextColumn Header="Setting" Binding="{Binding Definition.Title}" Width="180"/><DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="160"/><DataGridTextColumn Header="Proposed" Binding="{Binding ProposedValue}" Width="100"/><DataGridTextColumn Header="Risk" Binding="{Binding Definition.Risk}" Width="80"/><DataGridTextColumn Header="Trade-off" Binding="{Binding Definition.TradeOff}" Width="2*"/></DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Build read-only preview" Click="PreviewPlan_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        <TextBlock x:Name="PlanStatusText" Text="No plan prepared." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                        <DataGrid x:Name="PlanPreviewGrid" AutoGenerateColumns="False" Height="180" Margin="0,10,0,0" IsReadOnly="True" CanUserDeleteRows="False">
                            <DataGrid.Columns><DataGridTextColumn Header="Setting" Binding="{Binding Definition.Title}" Width="180"/><DataGridTextColumn Header="Current" Binding="{Binding BeforeDisplay}" Width="140"/><DataGridTextColumn Header="Proposed" Binding="{Binding AfterDisplay}" Width="140"/><DataGridTextColumn Header="Target" Binding="{Binding Address.TargetId}" Width="260"/><DataGridTextColumn Header="Restart" Binding="{Binding Definition.RestartRequirement}" Width="120"/></DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBlock x:Name="LogStatusText" Grid.Column="1" Foreground="{StaticResource WarningBrush}" Margin="0,0,18,0"/>
            <TextBlock Grid.Column="2" Text="PRE-ALPHA 0.1" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
