<Window x:Class="SockTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SockTuner.Views"
        Title="SockTuner" Icon="Assets/SockTuner.ico" Height="820" Width="1320" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindowStyle}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- One command row, like a Windows 11 app header: identity on the left, the actions that
             apply to the whole inventory on the right. -->
        <Grid Grid.Row="0" Margin="20,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="SockTuner" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Windows network control and gaming diagnostics" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="InventoryFilterText" Width="260" Margin="0,4,8,4"
                         Style="{StaticResource PlaceholderBox}" Tag="Search all inventory  (Ctrl+F)"
                         TextChanged="InventoryFilter_TextChanged" AutomationProperties.Name="Search all inventory"/>
                <Button Content="Refresh" ContentTemplate="{StaticResource IconContent}" Tag="&#xE72C;" Click="RefreshInventory_Click" Margin="0,4,8,4"
                        Style="{StaticResource PrimaryButton}" ToolTip="Re-read the whole Windows network inventory  (F5)"
                        AutomationProperties.Name="Refresh network inventory"/>
                <Button x:Name="CopyInventoryRowButton" Content="Copy row" ContentTemplate="{StaticResource IconContent}" Tag="&#xE8C8;" Click="CopyInventorySelected_Click"
                        Margin="0,4,8,4" IsEnabled="False"
                        ToolTip="Copies the selected inventory row as JSON"/>
                <!-- Three exports that are each used once a session do not each deserve a button
                     the width of the primary action. -->
                <Button x:Name="ExportMenuButton" Content="Export  ▾" ContentTemplate="{StaticResource IconContent}" Tag="&#xEDE1;" Click="ExportMenu_Click" Margin="0,4,12,4"
                        AutomationProperties.Name="Export menu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export snapshot…" Click="ExportSnapshot_Click"/>
                            <MenuItem Header="Export support snapshot…" Click="ExportSupportSnapshot_Click"/>
                            <MenuItem Header="Create compatibility report…" Click="CreateCompatibilityReport_Click"/>
                            <MenuItem Header="Export logs…" Click="ExportLogs_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <!-- Colours and icon are set by ShowWriteState: they follow the consent, not the XAML. -->
                <Border x:Name="WriteStateBadge" BorderThickness="1" CornerRadius="13" Padding="10,4,12,4" Margin="0,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="WriteStateIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock x:Name="WriteStateText" Text="Inventory only" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   ToolTip="Writes require accepting the change consent, elevation, and an explicit confirmation in the tuning plan."/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>

        <TabControl x:Name="InventoryTabs" Grid.Row="1" SelectionChanged="InventoryTabs_SelectionChanged">
            <TabItem Header="Overview" Style="{StaticResource NavGroupHeader}"/>

            <TabItem Header="Dashboard" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE ADAPTERS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ActiveAdaptersText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="NETWORK DEVICES" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AdapterCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="LOGICAL PROCESSORS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ProcessorCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="NDIS PARAMETERS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="NdisPropertyCountText" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PRIVILEGE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PrivilegeText" Text="—" FontSize="17" FontWeight="Bold" Margin="0,13,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Health check" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HealthSummaryText" Text="Runs automatically with every inventory refresh." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="OpenHealthSectionButton" Content="Open the section that fixes this" ContentTemplate="{StaticResource IconContent}" Tag="&#xE8A7;"
                                            Click="OpenHealthSection_Click" IsEnabled="False" VerticalAlignment="Top"/>
                                </Grid>
                                <!-- These rows are the point of the dashboard, so they wrap instead of
                                     clipping: an evidence line cut at "Configured: 8.8.8.8, 8.8.4.4, 19"
                                     is worse than no line at all. Double-click opens the fixing section. -->
                                <DataGrid x:Name="HealthGrid" AutoGenerateColumns="False" MinHeight="120" Margin="0,12,0,0"
                                          RowHeight="NaN" MinRowHeight="40"
                                          SelectionChanged="HealthGrid_SelectionChanged"
                                          MouseDoubleClick="HealthGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding SeverityBadge}" Width="130"
                                                            ElementStyle="{StaticResource VerdictCellText}"/>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="2*" MinWidth="130"
                                                            ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" MinWidth="130"
                                                            ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="What to do" Binding="{Binding Action}" Width="3*" MinWidth="130"
                                                            ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Network quality" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DashboardNetworkSummaryText"
                                           Text="Run Gaming diagnostics or a passive Wi-Fi observation to populate these charts."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,16"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="280"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition MinWidth="280"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GAME ENDPOINT LATENCY" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" Margin="0,8,0,8" Padding="8">
                                            <Viewbox Stretch="Fill" Height="120">
                                                <Canvas x:Name="DashboardLatencyCanvas" Width="600" Height="120" ClipToBounds="True"
                                                        AutomationProperties.Name="Game endpoint latency chart"/>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock x:Name="DashboardLatencyLegendText" Text="No completed latency measurement"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WI-FI ASSOCIATION" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" Margin="0,8,0,8" Padding="8">
                                            <Viewbox Stretch="Fill" Height="120">
                                                <Canvas x:Name="DashboardWifiCanvas" Width="600" Height="120" ClipToBounds="True"
                                                        AutomationProperties.Name="Wi-Fi signal and negotiated rate chart"/>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock x:Name="DashboardWifiLegendText" Text="No passive Wi-Fi observation"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="130"/>
                                <ColumnDefinition Width="*" MinWidth="130"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="System baseline" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Current read-only system facts. No setting is changed during discovery." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Operating system" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,16,5"/>
                                        <TextBlock x:Name="OsText" Grid.Column="1" Text="Loading…" Margin="0,5"/>
                                        <TextBlock Grid.Row="1" Text="Build" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,16,5"/>
                                        <TextBlock x:Name="BuildText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,5"/>
                                        <TextBlock Grid.Row="2" Text="Computer" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,16,5"/>
                                        <TextBlock x:Name="MachineText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,5"/>
                                        <TextBlock Grid.Row="3" Text="Captured" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,16,5"/>
                                        <TextBlock x:Name="CapturedText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Safe workflow" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="1  Inspect the current state" Margin="0,18,0,8"/>
                                    <TextBlock Text="2  Diagnose each network boundary" Margin="0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="3  Preview a typed change plan" Margin="0,8"/>
                                    <TextBlock Text="4  Snapshot, apply, verify, roll back" Margin="0,8" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="WorkflowWriteStateText" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                    <Separator Margin="0,18,0,14"/>
                                    <TextBlock Text="Recovery" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RecoverySummaryText" Text="No successful change is waiting to be undone."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="UndoLastChangeButton" Content="Undo last successful change" ContentTemplate="{StaticResource IconContent}" Tag="&#xE7A7;"
                                                Click="UndoLastChange_Click" IsEnabled="False" Margin="0,0,8,8"/>
                                        <Button Content="Check for drift" ContentTemplate="{StaticResource IconContent}" Tag="&#xE9D9;" Click="DashboardCheckDrift_Click" Margin="0,0,8,8"/>
                                        <Button Content="Open recovery history" ContentTemplate="{StaticResource IconContent}" Tag="&#xE81C;" Click="OpenTuningPlan_Click" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpdateVersionText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="UpdateStatusText" Text="Updates have not been checked yet."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,20,0"
                                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Right">
                                    <ComboBox x:Name="UpdateChannelComboBox" Width="110" Margin="0,0,8,8"
                                              SelectionChanged="UpdateChannel_SelectionChanged"
                                              AutomationProperties.Name="Update channel"/>
                                    <Button x:Name="CheckUpdatesButton" Content="Check for updates" ContentTemplate="{StaticResource IconContent}" Tag="&#xE895;" Margin="0,0,8,8"
                                            Click="CheckUpdates_Click"/>
                                    <Button x:Name="InstallUpdateButton" Content="Download and install" ContentTemplate="{StaticResource IconContent}" Tag="&#xE896;" Margin="0,0,0,8"
                                            Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                            Click="InstallUpdate_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Measure" Style="{StaticResource NavGroupHeader}"/>

            <TabItem Header="Gaming diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <WrapPanel>
                                <StackPanel Width="260" Margin="0,0,12,12">
                                    <TextBlock Text="ENDPOINT" Style="{StaticResource FieldLabelText}"/>
                                    <TextBox x:Name="DiagnosticTargetText" Margin="0,6,0,0" Style="{StaticResource PlaceholderBox}"
                                             Tag="Host name or IP"
                                             ToolTip="The game server or regional endpoint to measure. A host name or an IP address."
                                             AutomationProperties.Name="Game or regional endpoint"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,12,12">
                                    <TextBlock Text="PROFILE" Style="{StaticResource FieldLabelText}"/>
                                    <ComboBox x:Name="DiagnosticProfileComboBox" Margin="0,6,0,0"
                                              AutomationProperties.Name="Diagnostic profile">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="190" Margin="0,0,12,12">
                                    <TextBlock Text="GAME (TICK RATE)" Style="{StaticResource FieldLabelText}"/>
                                    <ComboBox x:Name="DiagnosticGameComboBox" Margin="0,6,0,0"
                                              ToolTip="Sets the probe's packet size and the thresholds the result is judged against"
                                              AutomationProperties.Name="Game tick rate profile">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,12,12">
                                    <TextBlock Text="LOAD" Style="{StaticResource FieldLabelText}"/>
                                    <ComboBox x:Name="DiagnosticLoadComboBox" Margin="0,6,0,0" AutomationProperties.Name="Load condition"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,12,12">
                                    <TextBlock Text="TCP PORT (OPTIONAL)" Style="{StaticResource FieldLabelText}"/>
                                    <TextBox x:Name="DiagnosticPortText" Margin="0,6,0,0" Style="{StaticResource PlaceholderBox}"
                                             Tag="e.g. 7777" ToolTip="Only verifies TCP connection setup"
                                             AutomationProperties.Name="Optional TCP port"/>
                                </StackPanel>
                                <Button x:Name="RunDiagnosticButton" Content="Run complete check" ContentTemplate="{StaticResource IconContent}" Tag="&#xE768;" Click="RunDiagnostic_Click"
                                        VerticalAlignment="Bottom" Margin="0,0,8,12" Style="{StaticResource PrimaryButton}"/>
                                <Button x:Name="CancelDiagnosticButton" Content="Cancel" ContentTemplate="{StaticResource IconContent}" Tag="&#xE711;" Click="CancelDiagnostic_Click"
                                        VerticalAlignment="Bottom" Margin="0,0,0,12" IsEnabled="False"/>
                            </WrapPanel>
                        </Border>

                        <ContentControl Style="{StaticResource InfoBar}" Margin="0,12,0,0"
                                        Content="Runs the read-only inventory and path checks together. Loaded-latency and throughput tests stay separate because they generate traffic."/>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Playable?" FontSize="20" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                ToolTip="The same measurement means different things to different games. A server updating 128 times a second cannot place an input that arrives 10 ms out of position, while one updating 20 times a second will not notice it — so the jitter limits here are derived from the selected tick rate rather than chosen, and the verdict is the worst of the three numbers, never their average."/>
                                <TextBlock x:Name="PlayabilityHeadlineText" Text="Not run" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PlayabilityDetailText" Text="Run a diagnosis to judge the game endpoint against a tick rate."
                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <DataGrid x:Name="PlayabilityMetricsGrid" AutoGenerateColumns="False" Margin="0,12,0,0" MaxHeight="190" RowHeight="NaN" MinRowHeight="40"
                                          Style="{StaticResource ResultGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="110" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Verdict" Binding="{Binding GradeBadge}" Width="160" ElementStyle="{StaticResource VerdictCellText}"/>
                                        <DataGridTextColumn Header="Measured" Binding="{Binding Measured}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Budget for this tick rate" Binding="{Binding Budget}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="PlayabilityTickText" Text="" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Did the change help?" FontSize="18" FontWeight="SemiBold"/>
                                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,0"
                                                        ToolTip="Applying a setting proves nothing on its own. Run a diagnosis, apply a plan, then re-run this identical diagnosis: the two are compared against what this path can actually resolve, so a difference smaller than the measurement's own noise is reported as no difference rather than as a win."/>
                                    </StackPanel>
                                    <Button x:Name="ReRunDiagnosticButton" Grid.Column="1" Content="Re-run and compare" ContentTemplate="{StaticResource IconContent}" Tag="&#xE895;"
                                            Click="ReRunAndCompare_Click" IsEnabled="False" VerticalAlignment="Top"
                                            Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                                            ToolTip="Repeats the diagnosis with exactly the parameters of the baseline run"/>
                                    <Button x:Name="ClearBaselineButton" Grid.Column="2" Content="Forget baseline" ContentTemplate="{StaticResource IconContent}" Tag="&#xE74D;"
                                            Click="ClearBaseline_Click" IsEnabled="False" VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock x:Name="VerificationHeadlineText" Text="No baseline yet."
                                           FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="VerificationDetailText"
                                           Text="Run a diagnosis, then apply a plan. The run from before the change becomes the baseline automatically."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <DataGrid x:Name="VerificationGrid" AutoGenerateColumns="False" Margin="0,12,0,0"
                                          MaxHeight="200" RowHeight="NaN" MinRowHeight="36"
                                          Style="{StaticResource ResultGrid}"
                                          AutomationProperties.Name="Before and after the applied change">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Verdict" Binding="{Binding VerdictBadge}" Width="130"
                                                            ElementStyle="{StaticResource VerdictCellText}"/>
                                        <DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="160" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Before and after" Binding="{Binding Display}" Width="*" MinWidth="220"
                                                            ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Import a capture report" FontSize="18" FontWeight="SemiBold"/>
                                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,0"
                                                        ToolTip="A packet capture knows the one thing this app cannot work out on its own: which server the game actually talked to, and how its packets were spaced. Import the report and SockTuner measures that endpoint itself rather than taking the numbers on trust."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Import report…" ContentTemplate="{StaticResource IconContent}" Tag="&#xE8B5;" Click="ImportGameReport_Click" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                    <Button x:Name="UseReportTargetButton" Grid.Column="2" Content="Use this endpoint" ContentTemplate="{StaticResource IconContent}" Tag="&#xE73E;"
                                            Click="UseReportTarget_Click" IsEnabled="False" VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock x:Name="ImportedReportText" Text="No report imported." Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <DataGrid x:Name="ImportedFindingsGrid" AutoGenerateColumns="False" MaxHeight="220" Margin="0,10,0,0"
                                          RowHeight="NaN" MinRowHeight="40" Visibility="Collapsed">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding SeverityBadge}" Width="130" ElementStyle="{StaticResource VerdictCellText}"/>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="What to do" Binding="{Binding Action}" Width="3*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Continuous monitor" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <TextBox x:Name="MonitorDurationText" Grid.Column="1" Text="30" AutomationProperties.Name="Monitor duration seconds"/>
                                <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                <TextBox x:Name="MonitorIntervalText" Grid.Column="3" Text="1000" AutomationProperties.Name="Monitor interval milliseconds"/>
                                <TextBlock Grid.Column="4" Text="ms" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <Button x:Name="MonitorStartButton" Content="Start" ContentTemplate="{StaticResource IconContent}" Tag="&#xE768;" Click="StartMonitor_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="MonitorStopButton" Content="Stop" ContentTemplate="{StaticResource IconContent}" Tag="&#xE71A;" Click="StopMonitor_Click" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="MonitorStatusText" Grid.Column="6" Text="Not running" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Border>

                        <!-- The probe targets read left to right as the path a packet takes, so the first
                             segment that looks wrong is where the trouble starts. -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="GATEWAY" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/><TextBlock x:Name="GatewayResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="REFERENCE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/><TextBlock x:Name="ReferenceResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Border Grid.Column="4" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="GAME ENDPOINT" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/><TextBlock x:Name="GameResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource Card}">
                                <StackPanel><TextBlock Text="DNS / CONNECTION" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/><TextBlock x:Name="DnsResultText" Text="Not run" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Where the problem starts" FontSize="20" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                ToolTip="Walks outward — adapter, LAN, router, ISP, external hop, endpoint — and stops at the first segment that degrades relative to the one before it."/>
                                <TextBlock x:Name="BottleneckResultText" Text="Not run" TextWrapping="Wrap" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Path shape" FontSize="20" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                ToolTip="NAT layers and path-MTU behaviour. Neither shows up in a latency measurement, and both explain whole classes of report — port forwarding that will not work, or downloads that stall while ping is fine."/>
                                <TextBlock x:Name="TopologyResultText" Text="Not run" TextWrapping="Wrap" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Evidence-ranked findings" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DiagnosticRunSummaryText" Text="Run a diagnosis to populate findings." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="Export report JSON" ContentTemplate="{StaticResource IconContent}" Tag="&#xEDE1;" Click="ExportReportJson_Click" Margin="0,0,8,0"/>
                                    <Button Content="Export report HTML" ContentTemplate="{StaticResource IconContent}" Tag="&#xEDE1;" Click="ExportReportHtml_Click" Margin="0,0,8,0"/>
                                    <Button Content="Export redacted HTML" ContentTemplate="{StaticResource IconContent}" Tag="&#xEDE1;" Click="ExportRedactedReportHtml_Click"/>
                                </StackPanel>
                                <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" MinHeight="190" RowHeight="NaN" MinRowHeight="40"
                                          Style="{StaticResource ResultGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="1.3*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Per-probe rows are evidence for the verdicts above, not the verdicts themselves:
                             folded away so the page reads as an answer first. -->
                        <Expander Header="Raw measurements" Margin="0,18,0,0" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Raw measurements">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Probe statistics" FontSize="20" FontWeight="SemiBold"/>
                                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                        ToolTip="Jitter is the mean absolute difference between consecutive successful RTT samples, so it moves with how fast the profile sent. Jitter (1s) is the standard deviation inside each one-second window, averaged — the same line reports the same figure at any probe rate, which is the one that can be compared against a game's tick budget. It is blank when no single second collected two replies."/>
                                        <DataGrid x:Name="DiagnosticStatisticsGrid" AutoGenerateColumns="False" MinHeight="150">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Target" Binding="{Binding Label}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="60" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="75" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Lost" Binding="{Binding Lost}" Width="60" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Min" Binding="{Binding MinimumMs}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Median" Binding="{Binding MedianMs}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Average" Binding="{Binding AverageMs}" Width="75" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="P95" Binding="{Binding P95Ms}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="P99" Binding="{Binding P99Ms}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Max" Binding="{Binding MaximumMs}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Jitter" Binding="{Binding JitterMs}" Width="70" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Jitter (1s)" Binding="{Binding WindowedJitterMs}" Width="80" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Spikes" Binding="{Binding SpikeSamples.Count}" Width="65" ElementStyle="{StaticResource WrapCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Probe and spike timeline" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                        <DataGrid x:Name="DiagnosticSamplesGrid" AutoGenerateColumns="False" MinHeight="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Target" Binding="{Binding Label}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="RTT ms" Binding="{Binding RoundTripTimeMs}" Width="90" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridCheckBoxColumn Header="Spike" Binding="{Binding IsSpike}" Width="65"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding FailureKind}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Repeated route samples" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                        <DataGrid x:Name="RouteSamplesGrid" AutoGenerateColumns="False" MinHeight="120">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Hops" Binding="{Binding HopsDisplay}" Width="3*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding FailureKind}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Detail" Binding="{Binding Error}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Monitoring timeline" FontSize="20" FontWeight="SemiBold"/>
                                        <DataGrid x:Name="MonitorSamplesGrid" AutoGenerateColumns="False" MinHeight="190" Margin="0,12,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Target" Binding="{Binding Label}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Address" Binding="{Binding Target}" Width="180" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Result" Binding="{Binding ResultDisplay}" Width="130" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding Kind}" Width="120" ElementStyle="{StaticResource WrapCellText}"/>
                                                <DataGridTextColumn Header="Detail" Binding="{Binding Error}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Wi-Fi diagnostics">
                <views:WifiDiagnosticsView x:Name="WifiDiagnostics"/>
            </TabItem>

            <TabItem Header="Throughput &amp; bufferbloat">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <WrapPanel>
                                <StackPanel Width="250" Margin="0,0,12,12">
                                    <TextBlock Text="THROUGHPUT ENDPOINT" Style="{StaticResource FieldLabelText}"/>
                                    <TextBox x:Name="ThroughputEndpointText" Margin="0,6,0,0" Style="{StaticResource PlaceholderBox}"
                                             Tag="Host you may load"
                                             ToolTip="Host that accepts a sustained transfer, for example a speed-test host you control"
                                             AutomationProperties.Name="Throughput endpoint"/>
                                </StackPanel>
                                <StackPanel Width="250" Margin="0,0,12,12">
                                    <TextBlock Text="LATENCY TARGET" Style="{StaticResource FieldLabelText}"/>
                                    <TextBox x:Name="LoadedLatencyTargetText" Margin="0,6,0,0" Style="{StaticResource PlaceholderBox}"
                                             Tag="Host to ping"
                                             ToolTip="Pinged idle and again under load to measure queue growth"
                                             AutomationProperties.Name="Latency target"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,12,12">
                                    <TextBlock Text="DIRECTION" Style="{StaticResource FieldLabelText}"/>
                                    <ComboBox x:Name="ThroughputDirectionComboBox" Margin="0,6,0,0" AutomationProperties.Name="Transfer direction"/>
                                </StackPanel>
                                <StackPanel Width="110" Margin="0,0,12,12">
                                    <TextBlock Text="STREAMS" Style="{StaticResource FieldLabelText}"/>
                                    <TextBox x:Name="ThroughputStreamsText" Text="4" Margin="0,6,0,0" AutomationProperties.Name="Parallel streams"/>
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,12,12">
                                    <TextBlock Text="SECONDS PER PHASE" Style="{StaticResource FieldLabelText}"/>
                                    <TextBox x:Name="ThroughputSecondsText" Text="10" Margin="0,6,0,0" AutomationProperties.Name="Seconds per phase"/>
                                </StackPanel>
                                <Button x:Name="RunThroughputButton" Content="Measure" ContentTemplate="{StaticResource IconContent}" Tag="&#xE768;" Click="RunThroughput_Click"
                                        VerticalAlignment="Bottom" Margin="0,0,8,12" Style="{StaticResource PrimaryButton}"/>
                                <Button x:Name="CancelThroughputButton" Content="Cancel" ContentTemplate="{StaticResource IconContent}" Tag="&#xE711;" Click="CancelThroughput_Click"
                                        VerticalAlignment="Bottom" Margin="0,0,0,12" IsEnabled="False"/>
                            </WrapPanel>
                        </Border>

                        <ContentControl Style="{StaticResource InfoBar}" Margin="0,12,0,0"
                                        Content="This moves real data over your connection and will saturate it for the duration. Nothing is written to Windows or the adapter. Choose an endpoint you are allowed to load."/>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Import an online bufferbloat result" FontSize="18" FontWeight="SemiBold"/>
                                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,0"
                                                        ToolTip="An online test measures the queue from outside your machine, over a path SockTuner cannot reach itself. Import the raw export and it is graded by the same code as a local run — from the file's own per-sample latencies, not from the letter the site printed — and it then feeds the recommendations and the router shaping advice exactly as a local run would."/>
                                        <TextBlock Text="Accepts the Waveform CSV export and a JSON report carrying per-sample latencies."
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Import result…" ContentTemplate="{StaticResource IconContent}" Tag="&#xE8B5;" Click="ImportBufferbloatReport_Click"
                                            VerticalAlignment="Top" Margin="0,0,8,0"/>
                                    <Button x:Name="ImportedReportRecommendButton" Grid.Column="2" Content="Build recommendations" ContentTemplate="{StaticResource IconContent}" Tag="&#xE82F;"
                                            Click="RecommendFromImport_Click" IsEnabled="False" VerticalAlignment="Top"
                                            Style="{StaticResource PrimaryButton}"/>
                                </Grid>
                                <TextBlock x:Name="ImportedBufferbloatText" Text="No external result imported."
                                           Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Bufferbloat grade" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BufferbloatGradeText" Text="Not measured" FontSize="34" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock x:Name="BufferbloatSummaryText" Text="Latency increase under load is graded on the Waveform scale. It describes queue growth in front of the slowest link, not link speed."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Measured throughput" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ThroughputResultText" Text="No run yet." Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Idle versus loaded" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LoadedLatencyResultText" Text="No run yet." Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="What this points at" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BufferbloatAssessmentText" Text="No run yet." Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="DNS resolvers">
                <views:DnsResolversView x:Name="DnsResolvers"/>
            </TabItem>

            <TabItem Header="Act" Style="{StaticResource NavGroupHeader}"/>

            <TabItem Header="Recommendations">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="130"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="WHAT THIS CONNECTION IS FOR" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                    <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,6,0,0"
                                                    ToolTip="Recommendations are derived from a measurement: the last diagnosis, the last bufferbloat run, or an online bufferbloat result imported on the Throughput tab. Run or import one first; nothing here measures anything by itself."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="USE-CASE PROFILE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                    <ComboBox x:Name="UseCaseComboBox" Margin="0,6,0,0" AutomationProperties.Name="Use-case profile">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="BuildRecommendationsButton" Grid.Column="2" Content="Build recommendations" ContentTemplate="{StaticResource IconContent}" Tag="&#xE82F;"
                                        Click="BuildRecommendations_Click" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="RecommendationSummaryText" Text="No recommendations yet." Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,12,0,0" TextWrapping="Wrap"/>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Changes this machine can make" FontSize="20" FontWeight="SemiBold"/>
                                        <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                        ToolTip="Only settings the driver or Windows currently advertises. Sending them to the tuning plan does not apply anything: the plan still previews, snapshots, verifies and can roll back."/>
                                    </StackPanel>
                                    <Button x:Name="SendAllToPlanButton" Grid.Column="1" Content="Send all to tuning plan" ContentTemplate="{StaticResource IconContent}" Tag="&#xE724;"
                                            Click="SendAllRecommendationsToPlan_Click" VerticalAlignment="Top" IsEnabled="False"
                                            Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                                            ToolTip="Queues every action this machine can make. The plan still previews, verifies and records them, and applying is still a separate confirmed step."/>
                                    <Button x:Name="SendToPlanButton" Grid.Column="2" Content="Send selected" ContentTemplate="{StaticResource IconContent}" Tag="&#xE724;"
                                            Click="SendRecommendationToPlan_Click" VerticalAlignment="Top" IsEnabled="False"
                                            Margin="0,0,8,0" ToolTip="Queues only the selected action"/>
                                    <Button x:Name="ExportChecklistButton" Grid.Column="3" Content="Export checklist…" ContentTemplate="{StaticResource IconContent}" Tag="&#xEDE1;"
                                            Click="ExportChecklist_Click" VerticalAlignment="Top" IsEnabled="False"
                                            ToolTip="Writes every action, including the router instructions and their OpenWrt commands, as a Markdown checklist"/>
                                </Grid>
                                <DataGrid x:Name="RemediationGrid" AutoGenerateColumns="False" MinHeight="150" RowHeight="NaN" MinRowHeight="40"
                                          Style="{StaticResource ResultGrid}"
                                          SelectionChanged="RemediationGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Action" Binding="{Binding Title}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Segment" Binding="{Binding Segment}" Width="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="140" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Changes" Binding="{Binding ChangesDisplay}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Expected effect" Binding="{Binding ExpectedEffect}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="Trade-off" Binding="{Binding TradeOff}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                        <DataGridTextColumn Header="How to verify" Binding="{Binding Verification}" Width="2*" MinWidth="130" ElementStyle="{StaticResource WrapCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Changes only the router can make" FontSize="20" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                ToolTip="The queue that causes bufferbloat lives on the device in front of the slow link. No amount of local tuning drains it."/>
                                <TextBlock x:Name="RouterGuidanceText" Text="No run yet." TextWrapping="Wrap" FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Wi-Fi radio" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WifiRadioText" Text="Not inspected." Margin="0,5,0,0" TextWrapping="Wrap" FontSize="15"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tuning plan">
                <views:TuningPlanView x:Name="TuningPlan"/>
            </TabItem>

            <TabItem Header="Interfaces">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Network devices" FontSize="22" FontWeight="SemiBold"/>
                                    <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,0"
                                                    ToolTip="Every interface this machine has, what it is doing right now, and what it costs to leave it up. The adapter carrying the default route is never offered for disabling: it is the way back in."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Bottom">
                                    <TextBlock Text="PROFILE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                    <ComboBox x:Name="InterfaceProfileComboBox" Width="230" Margin="0,6,0,0"
                                              SelectionChanged="InterfaceProfile_SelectionChanged"
                                              AutomationProperties.Name="Interface profile">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Open Device Manager" ContentTemplate="{StaticResource IconContent}" Tag="&#xE772;" Click="OpenDeviceManager_Click"
                                        VerticalAlignment="Bottom" Margin="0,0,8,0"
                                        ToolTip="Opens devmgmt.msc. Nothing is changed by opening it."/>
                                <Button Grid.Column="3" Content="Open connections" ContentTemplate="{StaticResource IconContent}" Tag="&#xE839;" Click="OpenNetworkConnections_Click"
                                        VerticalAlignment="Bottom"
                                        ToolTip="Opens the Windows Network Connections folder (ncpa.cpl)"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="InterfaceSummaryAdviceText" Text="Refresh the inventory to list network devices."
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="4,12,0,0" TextWrapping="Wrap"/>

                        <DataGrid x:Name="InterfaceAdviceGrid" AutoGenerateColumns="False" Margin="0,10,0,0"
                                  MinHeight="220" MaxHeight="330" RowHeight="NaN" MinRowHeight="40"
                                  SelectionChanged="InterfaceAdvice_SelectionChanged"
                                  AutomationProperties.Name="Network devices and advice">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="150" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="Kind" Binding="{Binding KindDisplay}" Width="100" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding RoleDisplay}" Width="130" ElementStyle="{StaticResource WrapCellText}"/>
                                <DataGridTextColumn Header="Advice" Binding="{Binding VerdictDisplay}" Width="150"
                                                    ElementStyle="{StaticResource VerdictCellText}"/>
                                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" MinWidth="170"
                                                    ElementStyle="{StaticResource WrapCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
                            <StackPanel>
                                <TextBlock x:Name="InterfaceDetailHeadingText" Text="Select a device" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="InterfaceDetailText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="The reason behind each verdict, and what disabling the device would cost, are shown here."
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Act on the selected device" FontSize="18" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoTip}" Content="How this works" Margin="0,5,0,12"
                                                ToolTip="Nothing here writes anything on its own. Each button queues one typed change on the tuning plan, where it is previewed against the live state, confirmed by hand, verified by read-back and recorded so it can be rolled back."/>
                                <WrapPanel>
                                    <Button x:Name="DisableInterfaceButton" Content="Queue: disable adapter" ContentTemplate="{StaticResource IconContent}" Tag="&#xE710;"
                                            Click="QueueDisableInterface_Click" IsEnabled="False" Margin="0,0,8,8"
                                            ToolTip="Only offered for a device this profile flags, and never for the adapter carrying the default route"/>
                                    <Button x:Name="EnableInterfaceButton" Content="Queue: enable adapter" ContentTemplate="{StaticResource IconContent}" Tag="&#xE710;"
                                            Click="QueueEnableInterface_Click" IsEnabled="False" Margin="0,0,8,8"/>
                                    <Button x:Name="PowerOffInterfaceButton" Content="Queue: no power saving" ContentTemplate="{StaticResource IconContent}" Tag="&#xE710;"
                                            Click="QueuePowerOff_Click" IsEnabled="False" Margin="0,0,8,8"
                                            ToolTip="Clears both power-management checkboxes on this adapter. Takes effect when the adapter next restarts."/>
                                    <Button x:Name="PowerDefaultInterfaceButton" Content="Queue: restore power default" ContentTemplate="{StaticResource IconContent}" Tag="&#xE710;"
                                            Click="QueuePowerDefault_Click" IsEnabled="False" Margin="0,0,8,8"
                                            ToolTip="Removes the override so the driver own INF decides again"/>
                                    <Button x:Name="OpenPlanButton" Content="Go to tuning plan" ContentTemplate="{StaticResource IconContent}" Tag="&#xE72A;" Click="OpenTuningPlan_Click"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock x:Name="InterfaceActionStatusText" Text="Nothing queued."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Interrupt affinity">
                <views:InterruptAffinityView x:Name="InterruptAffinity"/>
            </TabItem>

            <TabItem Header="Records" Style="{StaticResource NavGroupHeader}"/>

            <!-- Nine expert inventory tables are one destination with sub-pages: a first-time
                 user sees ten places to go instead of eighteen. Headers stay the section names
                 that health findings route to; FindSection looks inside this control too. -->
            <TabItem Header="Network details">
                <TabControl x:Name="DetailsTabs" Style="{StaticResource PivotTabControl}">
                    <TabItem Header="Adapters">
                        <Grid Margin="0,20,0,0">
