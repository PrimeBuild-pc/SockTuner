<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- TraceEvent locates KernelTraceControl beside its extracted managed assembly. -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <!-- Dev-build default; release.yml overrides it from the tag. -->
    <Version>0.9.0</Version>
    <ApplicationIcon>Assets\SockTuner.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21" />
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <Resource Include="Assets\SockTuner.ico" />
    <EmbeddedResource Include="Assets\i18n\translations.json" />
    <EmbeddedResource Include="Assets\verified-adapters.json" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
